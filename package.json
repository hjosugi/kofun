{
  "name": "kofun-language-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prepare:tour": "node site/prepare-tour.mjs",
    "build": "npm run prepare:tour && next build",
    "build:pages": "npm run prepare:tour && node site/build-pages.mjs",
    "build:sites": "opennextjs-cloudflare build",
    "start": "next start",
    "check:status": "node site/sync-status.mjs --check",
    "sync:status": "node site/sync-status.mjs",
    "test:docs": "node --experimental-strip-types site/docs-links.test.mjs",
    "test:design": "node site/design-tokens.test.mjs",
    "test:pages": "node site/pages-export.test.mjs",
    "test:playground": "node --experimental-strip-types site/playground.test.mjs",
    "test:status": "node site/status-snapshot.test.mjs",
    "test:tour": "sh docs/tour/check.sh",
    "verify:pages": "npm run test:design && npm run test:playground && npm run test:tour && npm run test:docs && npm run test:status && npm run build:pages && npm run test:pages",
    "verify:site": "npm run test:design && npm run test:playground && npm run test:tour && npm run test:docs && npm run test:status && npm run build"
  },
  "dependencies": {
    "next": "^16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  }
}
