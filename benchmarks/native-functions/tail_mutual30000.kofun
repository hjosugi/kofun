fn even_step(n: Int, seen: Int) -> Int {
    if n == 0 {
        return seen
    }
    return odd_step(n - 1, seen + 1)
}

fn odd_step(n: Int, seen: Int) -> Int {
    if n == 0 {
        return seen
    }
    return even_step(n - 1, seen + 1)
}

fn drive(rounds: Int, acc: Int) -> Int {
    if rounds == 0 {
        return acc
    }
    return drive(rounds - 1, acc + even_step(30000, 0))
}

fn main() {
    print(drive(350, 0))
}
