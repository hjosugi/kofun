fn sum_to(n: Int, total: Int) -> Int {
    if n == 0 {
        return total
    }
    return sum_to(n - 1, total + n)
}

fn drive(rounds: Int, acc: Int) -> Int {
    if rounds == 0 {
        return acc
    }
    return drive(rounds - 1, acc + sum_to(30000, 0))
}

fn main() {
    print(drive(350, 0))
}
