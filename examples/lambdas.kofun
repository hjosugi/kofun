# Lambdas in Kofun.
#
# Every form below is one the compiler accepts today. `task verify` runs this
# file through `kofun run` and compares its output, so this example cannot
# drift ahead of the implementation the way the documentation once did.
#
# A lambda is written with `=>`. A single unannotated parameter needs no
# parentheses; annotating it, or taking more than one, does. A callable
# parameter type uses the same arrow a declaration uses: `Int -> Int` takes one
# Int and returns an Int, `(Int, Int) -> Int` takes two, and `() -> Int` takes
# none. There is no implicit currying, so the arity is exactly what is written.

fn apply(action: Int -> Int, value: Int) -> Int {
    return action(value)
}

fn combine(op: (Int, Int) -> Int, left: Int, right: Int) -> Int {
    return op(left, right)
}

fn triple(value: Int) -> Int {
    return value * 3
}

fn main() -> Int {
    # A lambda bound to a name, then called by it.
    let double = value => value * 2
    print(double(21))

    # Annotating the parameter requires parentheses. `value: Int => ...` is
    # rejected, because `:` introduces a type everywhere else in the language.
    let increment = (value: Int) => value + 1
    print(increment(41))

    # Two parameters.
    let sum = (left, right) => left + right
    print(sum(40, 2))

    # A lambda may read a binding from the scope that encloses it.
    let offset = 40
    let shift = value => value + offset
    print(shift(2))

    # A lambda passed straight to a callable parameter, and the named function
    # that computes the same thing. Both are ordinary functions once compiled,
    # so they observe identically.
    print(apply(value => value * 3, 14))
    print(apply(triple, 14))

    # A lambda argument for a two-argument callable.
    print(combine((left, right) => left * right, 6, 7))

    return 0
}
