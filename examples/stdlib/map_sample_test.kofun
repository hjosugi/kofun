# kotest suite for map_sample.kofun; run with `kofun unittest`.

fn test_empty_map_misses_every_key() -> Int {
    let mut failures = 0
    failures = failures + expect_eq_int(map_size(map_empty()), 0)
    failures = failures + expect_eq_int(map_contains(map_empty(), 0), 0)
    let outcome: MapOutcome = map_get(map_empty(), 42)
    match outcome {
        MapMissingKey(key) => { failures = failures + expect_eq_int(key, 42) },
        _ => { failures = failures + fail_now("expected MapMissingKey") },
    }
    return failures
}

fn test_insert_then_get_round_trips() -> Int {
    let mut failures = 0
    let map: MapIntInt = map_insert(map_empty(), 10, 100)
    failures = failures + expect_eq_int(map_size(map), 1)
    failures = failures + expect_eq_int(map_get_or(map, 10, 0 - 1), 100)
    let outcome: MapOutcome = map_get(map, 10)
    match outcome {
        MapValue(value) => { failures = failures + expect_eq_int(value, 100) },
        _ => { failures = failures + fail_now("expected MapValue") },
    }
    return failures
}

fn test_insert_existing_key_updates_in_place() -> Int {
    let mut failures = 0
    let base: MapIntInt = map_insert(map_insert(map_empty(), 1, 11), 2, 22)
    let updated: MapIntInt = map_insert(base, 1, 99)
    failures = failures + expect_eq_int(map_size(updated), 2)
    failures = failures + expect_eq_int(map_get_or(updated, 1, 0 - 1), 99)
    failures = failures + expect_eq_int(map_get_or(updated, 2, 0 - 1), 22)
    failures = failures + expect_eq_int(map_get_or(base, 1, 0 - 1), 11)
    return failures
}

fn test_capacity_overflow_returns_input() -> Int {
    let mut failures = 0
    let full: MapIntInt = map_insert(map_insert(map_insert(
        map_empty(), 1, 10), 2, 20), 3, 30)
    failures = failures + expect_eq_int(map_size(full), map_capacity())
    let overflow: MapIntInt = map_insert(full, 4, 40)
    failures = failures + expect_eq_int(map_size(overflow), map_capacity())
    failures = failures + expect_eq_int(map_contains(overflow, 4), 0)
    let refreshed: MapIntInt = map_insert(full, 2, 21)
    failures = failures + expect_eq_int(map_get_or(refreshed, 2, 0 - 1), 21)
    return failures
}

fn test_remove_shifts_survivors_left() -> Int {
    let mut failures = 0
    let full: MapIntInt = map_insert(map_insert(map_insert(
        map_empty(), 1, 10), 2, 20), 3, 30)
    let removed_head: MapIntInt = map_remove(full, 1)
    failures = failures + expect_eq_int(map_size(removed_head), 2)
    failures = failures + expect_eq_int(map_contains(removed_head, 1), 0)
    failures = failures + expect_eq_int(map_get_or(removed_head, 2, 0 - 1), 20)
    failures = failures + expect_eq_int(map_get_or(removed_head, 3, 0 - 1), 30)
    let removed_mid: MapIntInt = map_remove(full, 2)
    failures = failures + expect_eq_int(map_get_or(removed_mid, 1, 0 - 1), 10)
    failures = failures + expect_eq_int(map_get_or(removed_mid, 3, 0 - 1), 30)
    let removed_missing: MapIntInt = map_remove(full, 9)
    failures = failures + expect_eq_int(map_size(removed_missing), 3)
    return failures
}

fn test_reinsert_after_remove() -> Int {
    let mut failures = 0
    let base: MapIntInt = map_insert(map_insert(map_empty(), 1, 10), 2, 20)
    let cycled: MapIntInt = map_insert(map_remove(base, 1), 1, 12)
    failures = failures + expect_eq_int(map_size(cycled), 2)
    failures = failures + expect_eq_int(map_get_or(cycled, 1, 0 - 1), 12)
    failures = failures + expect_eq_int(map_get_or(cycled, 2, 0 - 1), 20)
    return failures
}

fn test_smallest_key_scan_finds_ascending_order() -> Int {
    let mut failures = 0
    let map: MapIntInt = map_insert(map_insert(map_insert(
        map_empty(), 7, 70), 3, 30), 5, 50)
    failures = failures + expect_eq_int(smallest_key_at_least(map, 0, 0, 0 - 1), 3)
    failures = failures + expect_eq_int(smallest_key_at_least(map, 4, 0, 0 - 1), 5)
    failures = failures + expect_eq_int(smallest_key_at_least(map, 6, 0, 0 - 1), 7)
    failures = failures + expect_eq_int(smallest_key_at_least(map, 8, 0, 0 - 1), 0 - 1)
    return failures
}
