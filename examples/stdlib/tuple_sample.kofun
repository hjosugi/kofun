# stdlib/tuple sample: the Tuple[Int, Int] contract, executable today.
#
# Construction, fixed-position access, per-position transforms, combine,
# fold, swap, and lexicographic comparison — the surface documented by
# stdlib/tuple/tuple.kofun — implemented on the executable Stage 2 slice.
#
# Tests live in tuple_sample_test.kofun and run with `kofun unittest`.

type Pair = {
    first: Int,
    second: Int,
}

fn pair_make(first: Int, second: Int) -> Pair {
    let value: Pair = Pair(first: first, second: second)
    return value
}

fn pair_first(pair: Pair) -> Int {
    return pair.first
}

fn pair_second(pair: Pair) -> Int {
    return pair.second
}

fn pair_swap(pair: Pair) -> Pair {
    return pair_make(pair.second, pair.first)
}

fn pair_transform_first(pair: Pair, transform: Int -> Int) -> Pair {
    return pair_make(transform(pair.first), pair.second)
}

fn pair_transform_second(pair: Pair, transform: Int -> Int) -> Pair {
    return pair_make(pair.first, transform(pair.second))
}

fn pair_transform_both(pair: Pair, transform: Int -> Int) -> Pair {
    return pair_make(transform(pair.first), transform(pair.second))
}

fn pair_combine(pair: Pair, combine: (Int, Int) -> Int) -> Int {
    return combine(pair.first, pair.second)
}

# Lexicographic comparison: -1 when left < right, 0 on equality, 1 otherwise.
fn pair_compare(left: Pair, right: Pair) -> Int {
    if left.first < right.first {
        return 0 - 1
    }
    if left.first > right.first {
        return 1
    }
    if left.second < right.second {
        return 0 - 1
    }
    if left.second > right.second {
        return 1
    }
    return 0
}

fn pair_equal(left: Pair, right: Pair) -> Int {
    if pair_compare(left, right) == 0 {
        return 1
    }
    return 0
}

fn main() {
    let point: Pair = pair_make(3, 4)
    print(pair_first(point))
    print(pair_second(point))
    let flipped: Pair = pair_swap(point)
    print(pair_first(flipped))
    let doubled: Pair = pair_transform_both(point, value => value * 2)
    print(pair_combine(doubled, (a, b) => a + b))
    let shifted: Pair = pair_transform_first(
        pair_transform_second(point, value => value + 10),
        value => value - 1    )
    print(pair_combine(shifted, (a, b) => a * b))
    print(pair_compare(pair_make(1, 2), pair_make(1, 3)))
    print(pair_equal(point, pair_make(3, 4)))
}
