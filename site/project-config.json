{
  "schemaVersion": 1,
  "owner": "hjosugi",
  "repository": "hjosugi/kofun",
  "issueScope": "all",
  "title": "Kofun Delivery Roadmap",
  "snapshotPath": "site/plan-snapshot.json",
  "project": {
    "visibility": "PUBLIC",
    "description": "All kofun issues in one Project, with delivery fields synchronized for the open curated execution scope.",
    "readme": "## Operating model\n\n- Every open and closed issue from `hjosugi/kofun` is registered.\n- Related open `curated` issues are grouped into workstreams on stable writer lanes A, B, and C.\n- Independent workstreams run in parallel; one dedicated Review lane serializes integration and CI.\n- Every open `curated` issue receives rough Start Date, Target Date, and Iteration values for the Gantt.\n- Blocked and deferred dates are low-confidence placeholders, not promises; the issue workflow label remains authoritative.\n- Planning umbrellas remain visible without being treated as implementation work.\n- This board is where delivery planning lives; the public site does not publish a schedule.\n\n[Read the generated delivery plan](https://github.com/hjosugi/kofun/blob/main/docs/DELIVERY_PLAN.md) · [Browse the issues](https://github.com/hjosugi/kofun/issues)",
    "fields": [
      {
        "name": "Status",
        "type": "SINGLE_SELECT",
        "existing": true,
        "options": ["Todo", "In Progress", "Done"]
      },
      {
        "name": "Priority",
        "type": "SINGLE_SELECT",
        "options": ["P0", "P1", "P2", "P3"]
      },
      {
        "name": "Size",
        "type": "SINGLE_SELECT",
        "options": ["XS", "S", "M", "L", "XL"]
      },
      {
        "name": "Workstream",
        "type": "SINGLE_SELECT",
        "options": [
          "Self-host & Bootstrap",
          "Decimal",
          "Frontend & Types",
          "Backend & Runtime",
          "Effects & Concurrency",
          "Tooling & Diagnostics",
          "Stdlib & Frameworks",
          "Repository & Docs",
          "Science & Future",
          "Research & Positioning"
        ]
      },
      {
        "name": "Agent Slot",
        "type": "SINGLE_SELECT",
        "options": ["A", "B", "C", "Review"]
      },
      {
        "name": "Start Date",
        "type": "DATE"
      },
      {
        "name": "Target Date",
        "type": "DATE"
      },
      {
        "name": "Iteration",
        "type": "ITERATION",
        "iteration": {
          "startDate": "2026-07-27",
          "duration": 7,
          "count": 52,
          "titlePrefix": "Week"
        }
      }
    ],
    "views": [
      {
        "name": "Delivery roadmap",
        "layout": "roadmap",
        "filter": "is:issue is:open label:curated"
      },
      {
        "name": "This week",
        "layout": "board",
        "filter": "is:issue is:open label:curated"
      },
      {
        "name": "Agent capacity",
        "layout": "table",
        "filter": "is:issue is:open label:curated"
      }
    ]
  },
  "mappings": {
    "status": {
      "todo": "Todo",
      "ready": "Todo",
      "needs-detail": "Todo",
      "needs-decision": "Todo",
      "unclassified": "Todo",
      "blocked": "Todo",
      "deferred": "Todo",
      "scheduled": "Todo",
      "unscheduled": "Todo",
      "in-progress": "In Progress",
      "in progress": "In Progress",
      "review": "In Progress",
      "verification-pending": "In Progress",
      "done": "Done",
      "closed": "Done"
    },
    "priority": {
      "critical": "P0",
      "highest": "P0",
      "p0": "P0",
      "high": "P1",
      "p1": "P1",
      "medium": "P2",
      "normal": "P2",
      "p2": "P2",
      "low": "P3",
      "p3": "P3"
    },
    "size": {
      "xs": "XS",
      "s": "S",
      "m": "M",
      "l": "L",
      "xl": "XL"
    },
    "agentSlot": {
      "a": "A",
      "agent-a": "A",
      "writer-a": "A",
      "b": "B",
      "agent-b": "B",
      "writer-b": "B",
      "c": "C",
      "agent-c": "C",
      "writer-c": "C",
      "review": "Review",
      "reviewer": "Review",
      "integration": "Review"
    }
  },
  "api": {
    "projectsTokenSecret": "PROJECTS_TOKEN",
    "viewsVersion": "2026-03-10",
    "viewsDocumentation": "https://docs.github.com/en/rest/projects/views",
    "projectsActionsDocumentation": "https://docs.github.com/en/issues/planning-and-tracking-with-projects/automating-your-project/automating-projects-using-actions"
  }
}
