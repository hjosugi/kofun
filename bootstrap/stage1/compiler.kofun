# Kofun Stage 1 compiler seed.
#
# The compiler accepts a deliberately small Int/Bool/Text/List[Text] Core:
# `let` bindings, Int- or Text-valued `print(EXPR)` statements, and nested
# `if`/`else if`/`else` blocks inside `fn main()`. Every expression is tokenized,
# parsed, resolved and typed here, then lowered to a C11 statement sequence. The
# emitted program carries no parser or symbol table and retains no expression
# source beyond the Text literals it executes: names are resolved to typed C
# locals, integer literals are range-checked, and Text escapes are validated at
# compile time. This source is canonical; compiler.c is the audited bootstrap
# artifact generated from it.

fn identifier_char(char: Text) -> Bool {
    return is_xid_continue(char) ||
    contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", char)
}

fn valid_name(name: Text) -> Bool {
    let symbols = chars(name)
    if len(symbols) == 0 || is_digit(symbols[0]) {
        return false
    }
    for index in 0 .. len(symbols) {
        if !identifier_char(symbols[index]) {
            return false
        }
    }
    return true
}

fn digit_value(symbol: Text) -> Int {
    return find("0123456789", symbol)
}

fn all_digits(value: Text) -> Bool {
    let symbols = chars(value)
    if len(symbols) == 0 {
        return false
    }
    for index in 0 .. len(symbols) {
        if !is_digit(symbols[index]) {
            return false
        }
    }
    return true
}

# Digit-string comparison. Text ordering is outside the Core, so magnitudes are
# compared by significant length and then digit by digit.
fn within_bound(digits: Text, bound: Text) -> Bool {
    let symbols = chars(digits)
    let limit = chars(bound)
    let mut start = 0
    while start + 1 < len(symbols) && symbols[start] == "0" {
        start = start + 1
    }
    let significant = len(symbols) - start
    if significant != len(limit) {
        return significant < len(limit)
    }
    for index in 0 .. len(limit) {
        let left = digit_value(symbols[start + index])
        let right = digit_value(limit[index])
        if left != right {
            return left < right
        }
    }
    return true
}

# An operator is infix only when a complete operand precedes it; otherwise it is
# a prefix sign. This is what separates `-7 // 2` from `7 - 2`.
fn preceded_by_operand(expression: Text, index: Int) -> Bool {
    let symbols = chars(expression)
    let mut cursor = index - 1
    while cursor >= 0 {
        let symbol = symbols[cursor]
        if !is_space(symbol) {
            return symbol == ")" || symbol == "]" || symbol == "\"" ||
            identifier_char(symbol)
        }
        cursor = cursor - 1
    }
    return false
}

# Index of the last top-level infix operator drawn from `operators`, or -1.
# Splitting at the *last* one makes every operator left-associative. The second
# `/` of `//` is never preceded by an operand, so `//` reports its first byte.
fn split_binary(expression: Text, operators: Text) -> Int {
    let symbols = chars(expression)
    let mut depth = 0
    let mut found = -1
    let mut quoted = false
    let mut escaped = false
    for index in 0 .. len(symbols) {
        let symbol = symbols[index]
        if quoted {
            if escaped {
                escaped = false
            } else if symbol == "\\" {
                escaped = true
            } else if symbol == "\"" {
                quoted = false
            }
        } else if symbol == "\"" {
            quoted = true
        } else if symbol == "(" || symbol == "[" {
            depth = depth + 1
        } else if symbol == ")" || symbol == "]" {
            depth = depth - 1
        } else if depth == 0 && contains(operators, symbol) {
            if preceded_by_operand(expression, index) {
                found = index
            }
        }
    }
    return found
}

# Index of the last top-level complete operator token listed in the
# comma-delimited `operators` set, or -1. Two-byte tokens win over their
# one-byte prefixes, so `<=` is never split as `<` followed by `=`.
fn split_operators(expression: Text, operators: Text) -> Int {
    let symbols = chars(expression)
    let mut depth = 0
    let mut found = -1
    let mut quoted = false
    let mut escaped = false
    for index in 0 .. len(symbols) {
        let symbol = symbols[index]
        if quoted {
            if escaped {
                escaped = false
            } else if symbol == "\\" {
                escaped = true
            } else if symbol == "\"" {
                quoted = false
            }
        } else if symbol == "\"" {
            quoted = true
        } else if symbol == "(" || symbol == "[" {
            depth = depth + 1
        } else if symbol == ")" || symbol == "]" {
            depth = depth - 1
        } else if depth == 0 && preceded_by_operand(expression, index) {
            let mut candidate = symbol
            if index + 2 <= len(symbols) {
                let pair = text_slice(expression, index, index + 2)
                if find(operators, "," + pair + ",") >= 0 {
                    candidate = pair
                }
            }
            if find(operators, "," + candidate + ",") >= 0 {
                found = index
            }
        }
    }
    return found
}

fn wraps_whole(expression: Text) -> Bool {
    let symbols = chars(expression)
    if len(symbols) < 2 || !(symbols[0] == "(") {
        return false
    }
    let mut depth = 0
    let mut quoted = false
    let mut escaped = false
    for index in 0 .. len(symbols) {
        let symbol = symbols[index]
        if quoted {
            if escaped {
                escaped = false
            } else if symbol == "\\" {
                escaped = true
            } else if symbol == "\"" {
                quoted = false
            }
        } else if symbol == "\"" {
            quoted = true
        } else if symbol == "(" {
            depth = depth + 1
        } else if symbol == ")" {
            depth = depth - 1
            if depth == 0 {
                return index == len(symbols) - 1
            }
        }
    }
    return false
}

fn postfix_index(expression: Text) -> Int {
    let symbols = chars(expression)
    if len(symbols) < 3 || !(symbols[len(symbols) - 1] == "]") {
        return -1
    }
    let mut parens = 0
    let mut brackets = 0
    let mut found = -1
    let mut quoted = false
    let mut escaped = false
    for index in 0 .. len(symbols) {
        let symbol = symbols[index]
        if quoted {
            if escaped {
                escaped = false
            } else if symbol == "\\" {
                escaped = true
            } else if symbol == "\"" {
                quoted = false
            }
        } else if symbol == "\"" {
            quoted = true
        } else if symbol == "(" {
            parens = parens + 1
        } else if symbol == ")" {
            parens = parens - 1
        } else if symbol == "[" {
            if parens == 0 && brackets == 0 {
                found = index
            }
            brackets = brackets + 1
        } else if symbol == "]" {
            brackets = brackets - 1
            if brackets < 0 {
                return -1
            }
        }
    }
    if parens != 0 || brackets != 0 {
        return -1
    }
    return found
}

fn call_arity(expression: Text, callee: Text) -> Int {
    if !starts_with(expression, callee + "(") {
        return -1
    }
    let parenthesized = text_slice(expression, len(callee), len(expression))
    if !wraps_whole(parenthesized) {
        return -1
    }
    let body = text_slice(parenthesized, 1, len(parenthesized) - 1)
    if len(trim(body)) == 0 {
        return 0
    }
    let symbols = chars(body)
    let mut parens = 0
    let mut brackets = 0
    let mut arity = 1
    let mut quoted = false
    let mut escaped = false
    for index in 0 .. len(symbols) {
        let symbol = symbols[index]
        if quoted {
            if escaped {
                escaped = false
            } else if symbol == "\\" {
                escaped = true
            } else if symbol == "\"" {
                quoted = false
            }
        } else if symbol == "\"" {
            quoted = true
        } else if symbol == "(" {
            parens = parens + 1
        } else if symbol == ")" {
            parens = parens - 1
        } else if symbol == "[" {
            brackets = brackets + 1
        } else if symbol == "]" {
            brackets = brackets - 1
        } else if symbol == "," && parens == 0 && brackets == 0 {
            arity = arity + 1
        }
        if parens < 0 || brackets < 0 {
            return -1
        }
    }
    if quoted || parens != 0 || brackets != 0 {
        return -1
    }
    return arity
}

fn call_argument(expression: Text, callee: Text, target: Int) -> Text {
    let arity = call_arity(expression, callee)
    if target < 0 || target >= arity {
        return ""
    }
    let parenthesized = text_slice(expression, len(callee), len(expression))
    let body = text_slice(parenthesized, 1, len(parenthesized) - 1)
    let symbols = chars(body)
    let mut parens = 0
    let mut brackets = 0
    let mut current = 0
    let mut start = 0
    let mut quoted = false
    let mut escaped = false
    for index in 0 .. len(symbols) {
        let symbol = symbols[index]
        if quoted {
            if escaped {
                escaped = false
            } else if symbol == "\\" {
                escaped = true
            } else if symbol == "\"" {
                quoted = false
            }
        } else if symbol == "\"" {
            quoted = true
        } else if symbol == "(" {
            parens = parens + 1
        } else if symbol == ")" {
            parens = parens - 1
        } else if symbol == "[" {
            brackets = brackets + 1
        } else if symbol == "]" {
            brackets = brackets - 1
        } else if symbol == "," && parens == 0 && brackets == 0 {
            if current == target {
                return trim(text_slice(body, start, index))
            }
            current = current + 1
            start = index + 1
        }
    }
    return trim(text_slice(body, start, len(body)))
}

fn text_ends_with(value: Text, suffix: Text) -> Bool {
    if len(suffix) > len(value) {
        return false
    }
    return text_slice(value, len(value) - len(suffix), len(value)) == suffix
}

# The bootstrap profile is line-oriented, but canonical S wraps long
# declarations and expressions for review. Join only lines whose quote-aware
# delimiter depth or trailing operator says the expression is incomplete.
fn line_continues(line: Text) -> Bool {
    let symbols = chars(line)
    let mut parens = 0
    let mut brackets = 0
    let mut quoted = false
    let mut escaped = false
    for index in 0 .. len(symbols) {
        let symbol = symbols[index]
        if quoted {
            if escaped {
                escaped = false
            } else if symbol == "\\" {
                escaped = true
            } else if symbol == "\"" {
                quoted = false
            }
        } else if symbol == "\"" {
            quoted = true
        } else if symbol == "(" {
            parens = parens + 1
        } else if symbol == ")" {
            parens = parens - 1
        } else if symbol == "[" {
            brackets = brackets + 1
        } else if symbol == "]" {
            brackets = brackets - 1
        }
    }
    if quoted || parens > 0 || brackets > 0 {
        return true
    }
    return text_ends_with(line, "||") ||
    text_ends_with(line, "&&") ||
    text_ends_with(line, "+") ||
    text_ends_with(line, "-") ||
    text_ends_with(line, "*") ||
    text_ends_with(line, "/") ||
    text_ends_with(line, "%") ||
    text_ends_with(line, ",") ||
    text_ends_with(line, "=")
}

fn logical_source(source: Text) -> Text {
    let symbols = chars(source)
    let mut line_start = 0
    let mut pending = ""
    let mut result = ""
    for index in 0 .. len(symbols) {
        if symbols[index] == "\n" {
            let line = trim(text_slice(source, line_start, index))
            if len(line) > 0 && !starts_with(line, "#") {
                if len(pending) > 0 {
                    pending = pending + " "
                }
                pending = pending + line
                if !line_continues(pending) {
                    result = result + pending + "\n"
                    pending = ""
                }
            }
            line_start = index + 1
        }
    }
    if len(pending) > 0 {
        result = result + pending + "\n"
    }
    return result
}

fn valid_profile_type(kind: Text) -> Bool {
    return kind == "Int" || kind == "Bool" || kind == "Text" ||
    kind == "List[Text]" || kind == "Void"
}

fn function_name(line: Text) -> Text {
    if !starts_with(line, "fn ") {
        return ""
    }
    let open = find(line, "(")
    if open < 3 {
        return ""
    }
    return trim(text_slice(line, 3, open))
}

fn function_parameters(line: Text) -> Text {
    let open = find(line, "(")
    let close = find(line, ")")
    if open < 0 || close < open {
        return ""
    }
    return trim(text_slice(line, open + 1, close))
}

fn function_result(line: Text) -> Text {
    let close = find(line, ")")
    if close < 0 {
        return ""
    }
    let tail = trim(text_slice(line, close + 1, len(line)))
    if tail == "{" {
        return "Void"
    }
    if !starts_with(tail, "-> ") || !text_ends_with(tail, " {") {
        return ""
    }
    return trim(text_slice(tail, 3, len(tail) - 2))
}

fn parameter_arity(parameters: Text) -> Int {
    return call_arity("f(" + parameters + ")", "f")
}

fn parameter_part(parameters: Text, index: Int) -> Text {
    return call_argument("f(" + parameters + ")", "f", index)
}

fn parameter_name(parameters: Text, index: Int) -> Text {
    let part = parameter_part(parameters, index)
    let colon = find(part, ":")
    if colon < 0 {
        return ""
    }
    return trim(text_slice(part, 0, colon))
}

fn parameter_type(parameters: Text, index: Int) -> Text {
    let part = parameter_part(parameters, index)
    let colon = find(part, ":")
    if colon < 0 {
        return ""
    }
    return trim(text_slice(part, colon + 1, len(part)))
}

fn parameter_types(parameters: Text) -> Text {
    let mut result = ""
    for index in 0 .. parameter_arity(parameters) {
        if index > 0 {
            result = result + ","
        }
        result = result + parameter_type(parameters, index)
    }
    return result
}

fn valid_function_header(line: Text) -> Bool {
    if !text_ends_with(line, " {") {
        return false
    }
    let name = function_name(line)
    let result = function_result(line)
    let parameters = function_parameters(line)
    let arity = parameter_arity(parameters)
    if !valid_name(name) || !valid_profile_type(result) ||
       arity < 0 || arity > 5 {
        return false
    }
    let mut seen = "|"
    for index in 0 .. arity {
        let parameter = parameter_name(parameters, index)
        let kind = parameter_type(parameters, index)
        if !valid_name(parameter) || !valid_profile_type(kind) ||
           kind == "Void" || find(seen, "|" + parameter + "|") >= 0 {
            return false
        }
        seen = seen + parameter + "|"
    }
    return true
}

# Function signatures share `bound` with lexical bindings under an `@` prefix.
# Scope pop therefore discards locals while preserving the complete top-level
# signature table needed for forward and recursive calls.
fn collect_function_signatures(source: Text) -> Text {
    let symbols = chars(source)
    let mut line_start = 0
    let mut functions = "|"
    let mut count = 0
    for index in 0 .. len(symbols) {
        if symbols[index] == "\n" {
            let line = trim(text_slice(source, line_start, index))
            if starts_with(line, "fn ") {
                if !valid_function_header(line) {
                    return ""
                }
                let name = function_name(line)
                if find(functions, "|@" + name + ":") >= 0 {
                    return ""
                }
                functions = functions + "@" + name + ":" +
                function_result(line) + ";" +
                parameter_types(function_parameters(line)) + "|"
                count = count + 1
            }
            line_start = index + 1
        }
    }
    if count == 0 {
        return ""
    }
    return functions
}

fn function_signature(bound: Text, name: Text) -> Text {
    let marker = "|@" + name + ":"
    let start = find(bound, marker)
    if start < 0 {
        return ""
    }
    let tail = text_slice(bound, start + len(marker), len(bound))
    let finish = find(tail, "|")
    if finish < 0 {
        return ""
    }
    return text_slice(tail, 0, finish)
}

fn signature_result(signature: Text) -> Text {
    let split = find(signature, ";")
    if split < 0 {
        return ""
    }
    return text_slice(signature, 0, split)
}

fn signature_parameters(signature: Text) -> Text {
    let split = find(signature, ";")
    if split < 0 {
        return ""
    }
    return text_slice(signature, split + 1, len(signature))
}

fn function_bound(functions: Text, line: Text) -> Text {
    let parameters = function_parameters(line)
    let mut bound = scope_enter(functions)
    for index in 0 .. parameter_arity(parameters) {
        bound = bound + parameter_name(parameters, index) + ":" +
        parameter_type(parameters, index) + "|"
    }
    return bound
}

fn emitted_c_type(kind: Text) -> Text {
    if kind == "Bool" {
        return "bool"
    }
    if kind == "Text" {
        return "const char *"
    }
    if kind == "List[Text]" {
        return "KofunTextList"
    }
    if kind == "Void" {
        return "void"
    }
    return "int64_t"
}

fn failure_return(kind: Text) -> Text {
    if kind == "Bool" {
        return "if (failed) return false;\n"
    }
    if kind == "Text" {
        return "if (failed) return \"\";\n"
    }
    if kind == "List[Text]" {
        return "if (failed) return kofun_rt_empty_text_list();\n"
    }
    if kind == "Void" {
        return "if (failed) return;\n"
    }
    return "if (failed) return 0;\n"
}

# A lowered expression is `TYPE|STATEMENTS + OPERAND`: its static type, zero or
# more complete C statements ending in newlines, then a newline-free operand.
# The type prefix is compiler-only and is removed before C emission. Emitting
# one statement per operator makes evaluation order observable and fixed: C
# leaves argument evaluation order unspecified, so a nested call tree would
# let the host compiler decide which failing operator reports first.
#
# `indent` is the C indentation every statement of one expression is written at.
# It is threaded rather than fixed because a block nests the statement it
# belongs to; it never changes which expressions are accepted or their types.
fn last_newline(value: Text) -> Int {
    let symbols = chars(value)
    let mut found = -1
    for index in 0 .. len(symbols) {
        if symbols[index] == "\n" {
            found = index
        }
    }
    return found
}

fn lowered_type(lowered: Text) -> Text {
    if starts_with(lowered, "Int|") {
        return "Int"
    }
    if starts_with(lowered, "Bool|") {
        return "Bool"
    }
    if starts_with(lowered, "Text|") {
        return "Text"
    }
    if starts_with(lowered, "List[Text]|") {
        return "List[Text]"
    }
    if starts_with(lowered, "Void|") {
        return "Void"
    }
    return ""
}

fn lowered_value(lowered: Text) -> Text {
    let kind = lowered_type(lowered)
    if len(kind) == 0 {
        return ""
    }
    return text_slice(lowered, len(kind) + 1, len(lowered))
}

fn lowered_statements(lowered: Text) -> Text {
    let value = lowered_value(lowered)
    let cut = last_newline(value)
    if cut < 0 {
        return ""
    }
    return text_slice(value, 0, cut + 1)
}

fn lowered_operand(lowered: Text) -> Text {
    let value = lowered_value(lowered)
    let cut = last_newline(value)
    return text_slice(value, cut + 1, len(value))
}

# Each operator node owns a temporary named after its path from the root of the
# expression, so names are unique without a mutable counter.
fn lower_step(path: Text, indent: Text, callee: Text, left: Text,
              right: Text) -> Text {
    if !(lowered_type(left) == "Int") || !(lowered_type(right) == "Int") {
        return ""
    }
    let temporary = "kt_" + path
    return "Int|" +
    lowered_statements(left) + lowered_statements(right) +
    indent + "int64_t " + temporary + " = " + callee +
    lowered_operand(left) + ", " + lowered_operand(right) + ");\n" +
    temporary
}

fn lower_comparison(path: Text, indent: Text, operator: Text, left: Text,
                    right: Text) -> Text {
    let left_type = lowered_type(left)
    let right_type = lowered_type(right)
    if operator == "==" || operator == "!=" {
        if len(left_type) == 0 || !(left_type == right_type) {
            return ""
        }
        if left_type == "List[Text]" {
            return ""
        }
    } else if !(left_type == "Int") || !(right_type == "Int") {
        return ""
    }
    let temporary = "kt_" + path
    if left_type == "Text" {
        let mut negated = ""
        if operator == "!=" {
            negated = "!"
        }
        return "Bool|" +
        lowered_statements(left) + lowered_statements(right) +
        indent + "bool " + temporary + " = " + negated +
        "kofun_rt_text_equal(" + lowered_operand(left) + ", " +
        lowered_operand(right) + ");\n" +
        temporary
    }
    return "Bool|" +
    lowered_statements(left) + lowered_statements(right) +
    indent + "bool " + temporary + " = " + lowered_operand(left) + " " +
    operator + " " + lowered_operand(right) + ";\n" +
    temporary
}

fn lower_logical(path: Text, indent: Text, operator: Text, left: Text,
                 right: Text) -> Text {
    if !(lowered_type(left) == "Bool") ||
       !(lowered_type(right) == "Bool") {
        return ""
    }
    let temporary = "kt_" + path
    let mut condition = temporary
    if operator == "||" {
        condition = "!" + temporary
    }
    return "Bool|" +
    lowered_statements(left) +
    indent + "bool " + temporary + " = " + lowered_operand(left) + ";\n" +
    indent + "if (!failed && " + condition + ") {\n" +
    lowered_statements(right) +
    indent + "    " + temporary + " = " + lowered_operand(right) + ";\n" +
    indent + "}\n" +
    temporary
}

fn bound_type(bound: Text, name: Text) -> Text {
    if find(bound, "|" + name + ":Int|") >= 0 ||
       find(bound, "|" + name + ":Int!|") >= 0 {
        return "Int"
    }
    if find(bound, "|" + name + ":Bool|") >= 0 ||
       find(bound, "|" + name + ":Bool!|") >= 0 {
        return "Bool"
    }
    if find(bound, "|" + name + ":Text|") >= 0 ||
       find(bound, "|" + name + ":Text!|") >= 0 {
        return "Text"
    }
    if find(bound, "|" + name + ":List[Text]|") >= 0 ||
       find(bound, "|" + name + ":List[Text]!|") >= 0 {
        return "List[Text]"
    }
    return ""
}

fn bound_mutable(bound: Text, name: Text) -> Bool {
    return find(bound, "|" + name + ":Int!|") >= 0 ||
    find(bound, "|" + name + ":Bool!|") >= 0 ||
    find(bound, "|" + name + ":Text!|") >= 0 ||
    find(bound, "|" + name + ":List[Text]!|") >= 0
}

fn lower_atom(atom: Text, bound: Text) -> Text {
    let symbols = chars(atom)
    if len(symbols) >= 2 && symbols[0] == "\"" &&
       symbols[len(symbols) - 1] == "\"" {
        let mut escaped = false
        for index in 1 .. len(symbols) - 1 {
            let symbol = symbols[index]
            if escaped {
                if !(symbol == "n") && !(symbol == "\"") &&
                   !(symbol == "\\") {
                    return ""
                }
                escaped = false
            } else if symbol == "\\" {
                escaped = true
            } else if symbol == "\"" {
                return ""
            }
        }
        if escaped {
            return ""
        }
        return "Text|" + atom
    }
    if all_digits(atom) {
        if !within_bound(atom, "9223372036854775807") {
            return ""
        }
        return "Int|" + atom
    }
    if atom == "true" || atom == "false" {
        return "Bool|" + atom
    }
    if !valid_name(atom) {
        return ""
    }
    let kind = bound_type(bound, atom)
    if len(kind) == 0 {
        return ""
    }
    return kind + "|kf_" + atom
}

# A negated decimal literal is folded at compile time so that the one magnitude
# with no positive counterpart still has a C spelling.
fn lower_negation(operand: Text, bound: Text, path: Text,
                  indent: Text) -> Text {
    let trimmed = trim(operand)
    if all_digits(trimmed) {
        if within_bound(trimmed, "9223372036854775807") {
            return "Int|-" + trimmed
        }
        if within_bound(trimmed, "9223372036854775808") {
            return "Int|INT64_MIN"
        }
        return ""
    }
    let inner = lower_expression(trimmed, bound, path + "u", indent)
    if !(lowered_type(inner) == "Int") {
        return ""
    }
    let temporary = "kt_" + path
    return "Int|" + lowered_statements(inner) +
    indent + "int64_t " + temporary + " = checked_neg(" +
    lowered_operand(inner) + ");\n" +
    temporary
}

fn lower_builtin_call(expression: Text, callee: Text, bound: Text,
                      path: Text, indent: Text) -> Text {
    let mut arity = 1
    let mut first_type = "Text"
    let mut second_type = ""
    let mut third_type = ""
    let mut result_type = "Bool"
    let mut runtime = "kofun_rt_" + callee
    let mut first_path = "a"
    if callee == "args" {
        arity = 0
        first_type = ""
        result_type = "List[Text]"
    } else if callee == "fail" {
        arity = 0
        first_type = ""
        result_type = "Void"
    } else if callee == "chars" {
        result_type = "List[Text]"
        first_path = "c"
    } else if callee == "contains" {
        arity = 2
        second_type = "Text"
        runtime = "kofun_rt_text_contains"
    } else if callee == "find" {
        arity = 2
        second_type = "Text"
        result_type = "Int"
    } else if callee == "len" {
        first_type = "TextOrList"
        result_type = "Int"
        runtime = "kofun_rt_text_len"
        first_path = "n"
    } else if callee == "read_text" {
        result_type = "Text"
    } else if callee == "starts_with" {
        arity = 2
        second_type = "Text"
    } else if callee == "text_slice" {
        arity = 3
        second_type = "Int"
        third_type = "Int"
        result_type = "Text"
    } else if callee == "trim" {
        result_type = "Text"
    } else if callee == "validate_unicode_source" {
        result_type = "Text"
    } else if callee == "write_text" {
        arity = 2
        second_type = "Text"
        result_type = "Void"
    }
    if call_arity(expression, callee) != arity {
        return ""
    }
    let mut first = ""
    let mut second = ""
    let mut third = ""
    let mut statements = ""
    let mut arguments = ""
    if arity >= 1 {
        first = lower_expression(call_argument(expression, callee, 0), bound,
                                 path + first_path, indent)
        let kind = lowered_type(first)
        if first_type == "TextOrList" &&
           !(kind == "Text") && !(kind == "List[Text]") ||
           (!(first_type == "TextOrList") && !(kind == first_type)) {
            return ""
        }
        statements = statements + lowered_statements(first)
        arguments = lowered_operand(first)
    }
    if arity >= 2 {
        second = lower_expression(call_argument(expression, callee, 1), bound,
                                  path + "b", indent)
        if !(lowered_type(second) == second_type) {
            return ""
        }
        statements = statements + lowered_statements(second)
        arguments = arguments + ", " + lowered_operand(second)
    }
    if arity >= 3 {
        third = lower_expression(call_argument(expression, callee, 2), bound,
                                 path + "c", indent)
        if !(lowered_type(third) == third_type) {
            return ""
        }
        statements = statements + lowered_statements(third)
        arguments = arguments + ", " + lowered_operand(third)
    }

    let mut emitted_callee = runtime
    if callee == "args" {
        arguments = "argc, argv"
    } else if callee == "len" {
        if lowered_type(first) == "Text" {
            emitted_callee = "kofun_rt_text_len"
        } else {
            emitted_callee = "kofun_rt_text_list_len"
        }
    }

    if result_type == "Void" {
        return "Void|" + statements + indent + emitted_callee + "(" +
        arguments + ");\n0"
    }
    let temporary = "kt_" + path
    let mut c_type = "int64_t"
    if result_type == "Bool" {
        c_type = "bool"
    } else if result_type == "Text" {
        c_type = "const char *"
    } else if result_type == "List[Text]" {
        c_type = "KofunTextList"
    }
    return result_type + "|" + statements + indent + c_type + " " +
    temporary + " = " + emitted_callee + "(" + arguments + ");\n" +
    temporary
}

fn lower_builtin_dispatch(expression: Text, bound: Text, path: Text,
                          indent: Text) -> Text {
    let open = find(expression, "(")
    if open < 0 {
        return ""
    }
    let callee = text_slice(expression, 0, open)
    let builtins =
    "|args|chars|contains|fail|find|is_digit|is_space|is_xid_continue|len|" +
    "read_text|starts_with|text_slice|trim|validate_unicode_source|write_text|"
    if find(builtins, "|" + callee + "|") < 0 {
        return ""
    }
    return lower_builtin_call(expression, callee, bound, path, indent)
}

fn signature_parameter_type(signature: Text, index: Int) -> Text {
    let parameters = signature_parameters(signature)
    return call_argument("f(" + parameters + ")", "f", index)
}

fn lower_user_call(expression: Text, bound: Text, path: Text,
                   indent: Text) -> Text {
    let open = find(expression, "(")
    if open < 0 {
        return ""
    }
    let callee = text_slice(expression, 0, open)
    let signature = function_signature(bound, callee)
    if len(signature) == 0 {
        return ""
    }
    let expected = parameter_arity(signature_parameters(signature))
    if call_arity(expression, callee) != expected || expected > 5 {
        return ""
    }
    let mut first = ""
    let mut second = ""
    let mut third = ""
    let mut fourth = ""
    let mut fifth = ""
    let mut statements = ""
    let mut arguments = ""
    if expected >= 1 {
        first = lower_expression(call_argument(expression, callee, 0), bound,
                                 path + "a", indent)
        if !(lowered_type(first) ==
             signature_parameter_type(signature, 0)) {
            return ""
        }
        statements = statements + lowered_statements(first)
        arguments = lowered_operand(first)
    }
    if expected >= 2 {
        second = lower_expression(call_argument(expression, callee, 1), bound,
                                  path + "b", indent)
        if !(lowered_type(second) ==
             signature_parameter_type(signature, 1)) {
            return ""
        }
        statements = statements + lowered_statements(second)
        arguments = arguments + ", " + lowered_operand(second)
    }
    if expected >= 3 {
        third = lower_expression(call_argument(expression, callee, 2), bound,
                                 path + "c", indent)
        if !(lowered_type(third) ==
             signature_parameter_type(signature, 2)) {
            return ""
        }
        statements = statements + lowered_statements(third)
        arguments = arguments + ", " + lowered_operand(third)
    }
    if expected >= 4 {
        fourth = lower_expression(call_argument(expression, callee, 3), bound,
                                  path + "d", indent)
        if !(lowered_type(fourth) ==
             signature_parameter_type(signature, 3)) {
            return ""
        }
        statements = statements + lowered_statements(fourth)
        arguments = arguments + ", " + lowered_operand(fourth)
    }
    if expected >= 5 {
        fifth = lower_expression(call_argument(expression, callee, 4), bound,
                                 path + "e", indent)
        if !(lowered_type(fifth) ==
             signature_parameter_type(signature, 4)) {
            return ""
        }
        statements = statements + lowered_statements(fifth)
        arguments = arguments + ", " + lowered_operand(fifth)
    }
    let result = signature_result(signature)
    if result == "Void" {
        return "Void|" + statements + indent + "kf_" + callee + "(" +
        arguments + ");\n0"
    }
    let temporary = "kt_" + path
    return result + "|" + statements + indent + emitted_c_type(result) + " " +
    temporary + " = kf_" + callee + "(" + arguments + ");\n" + temporary
}

# Lowers one Core expression to a C11 expression, or "" when it is not Core.
# Acceptance is exactly "this returns a non-empty string", so the parser is the
# only definition of what the Core admits.
fn lower_expression(expression: Text, bound: Text, path: Text,
                    indent: Text) -> Text {
    let trimmed = trim(expression)
    if len(trimmed) == 0 {
        return ""
    }

    let logical_or = split_operators(trimmed, ",||,")
    if logical_or >= 0 {
        let left = lower_expression(
            text_slice(trimmed, 0, logical_or), bound, path + "l", indent)
        let right = lower_expression(
            text_slice(trimmed, logical_or + 2, len(trimmed)),
            bound, path + "r", indent)
        return lower_logical(path, indent, "||", left, right)
    }

    let logical_and = split_operators(trimmed, ",&&,")
    if logical_and >= 0 {
        let left = lower_expression(
            text_slice(trimmed, 0, logical_and), bound, path + "l", indent)
        let right = lower_expression(
            text_slice(trimmed, logical_and + 2, len(trimmed)),
            bound, path + "r", indent)
        return lower_logical(path, indent, "&&", left, right)
    }

    let equality = split_operators(trimmed, ",==,!=,")
    if equality >= 0 {
        let operator = text_slice(trimmed, equality, equality + 2)
        let left = lower_expression(
            text_slice(trimmed, 0, equality), bound, path + "l", indent)
        let right = lower_expression(
            text_slice(trimmed, equality + 2, len(trimmed)),
            bound, path + "r", indent)
        return lower_comparison(path, indent, operator, left, right)
    }

    let ordering = split_operators(trimmed, ",<=,>=,<,>,")
    if ordering >= 0 {
        let mut skip = 1
        if ordering + 2 <= len(trimmed) &&
           text_slice(trimmed, ordering + 1, ordering + 2) == "=" {
            skip = 2
        }
        let operator = text_slice(trimmed, ordering, ordering + skip)
        let left = lower_expression(
            text_slice(trimmed, 0, ordering), bound, path + "l", indent)
        let right = lower_expression(
            text_slice(trimmed, ordering + skip, len(trimmed)),
            bound, path + "r", indent)
        return lower_comparison(path, indent, operator, left, right)
    }

    let additive = split_binary(trimmed, "+-")
    if additive >= 0 {
        let left = lower_expression(
            text_slice(trimmed, 0, additive), bound, path + "l", indent)
        let right = lower_expression(
            text_slice(trimmed, additive + 1, len(trimmed)), bound,
            path + "r", indent)
        if len(left) == 0 || len(right) == 0 {
            return ""
        }
        if text_slice(trimmed, additive, additive + 1) == "+" {
            if lowered_type(left) == "Text" &&
               lowered_type(right) == "Text" {
                let temporary = "kt_" + path
                return "Text|" +
                lowered_statements(left) + lowered_statements(right) +
                indent + "const char * " + temporary +
                " = kofun_rt_text_concat(" + lowered_operand(left) + ", " +
                lowered_operand(right) + ");\n" +
                temporary
            }
            return lower_step(path, indent, "checked_add(", left, right)
        }
        return lower_step(path, indent, "checked_sub(", left, right)
    }

    let multiplicative = split_binary(trimmed, "*%/")
    if multiplicative >= 0 {
        let operator = text_slice(trimmed, multiplicative, multiplicative + 1)
        let mut callee = "checked_mul("
        let mut skip = 1
        if operator == "%" {
            callee = "floor_mod("
        } else if operator == "/" {
            # `/` is not defined on Int; only the floor operator `//` is Core.
            if multiplicative + 2 > len(trimmed) {
                return ""
            }
            if !(text_slice(trimmed, multiplicative + 1,
                            multiplicative + 2) == "/") {
                return ""
            }
            callee = "floor_div("
            skip = 2
        }
        let left = lower_expression(
            text_slice(trimmed, 0, multiplicative), bound, path + "l", indent)
        let right = lower_expression(
            text_slice(trimmed, multiplicative + skip, len(trimmed)),
            bound, path + "r", indent)
        if len(left) == 0 || len(right) == 0 {
            return ""
        }
        return lower_step(path, indent, callee, left, right)
    }

    let index_open = postfix_index(trimmed)
    if index_open >= 0 {
        let base = lower_expression(
            text_slice(trimmed, 0, index_open), bound, path + "b", indent)
        let index = lower_expression(
            text_slice(trimmed, index_open + 1, len(trimmed) - 1), bound,
            path + "i", indent)
        let base_type = lowered_type(base)
        if !(lowered_type(index) == "Int") ||
           (!(base_type == "Text") && !(base_type == "List[Text]")) {
            return ""
        }
        let mut callee = "kofun_rt_text_index("
        if base_type == "List[Text]" {
            callee = "kofun_rt_text_list_get("
        }
        let temporary = "kt_" + path
        return "Text|" +
        lowered_statements(base) + lowered_statements(index) +
        indent + "const char * " + temporary + " = " + callee +
        lowered_operand(base) + ", " + lowered_operand(index) + ");\n" +
        temporary
    }

    let builtin = lower_builtin_dispatch(trimmed, bound, path, indent)
    if len(builtin) > 0 {
        return builtin
    }
    let user_call = lower_user_call(trimmed, bound, path, indent)
    if len(user_call) > 0 {
        return user_call
    }

    if starts_with(trimmed, "+") {
        let inner = lower_expression(
            text_slice(trimmed, 1, len(trimmed)), bound, path, indent)
        if !(lowered_type(inner) == "Int") {
            return ""
        }
        return inner
    }
    if starts_with(trimmed, "-") {
        return lower_negation(text_slice(trimmed, 1, len(trimmed)), bound, path,
                              indent)
    }
    if starts_with(trimmed, "!") {
        let inner = lower_expression(
            text_slice(trimmed, 1, len(trimmed)), bound, path + "u", indent)
        if !(lowered_type(inner) == "Bool") {
            return ""
        }
        let temporary = "kt_" + path
        return "Bool|" + lowered_statements(inner) +
        indent + "bool " + temporary + " = !" + lowered_operand(inner) + ";\n" +
        temporary
    }
    if wraps_whole(trimmed) {
        return lower_expression(
            text_slice(trimmed, 1, len(trimmed) - 1), bound, path, indent)
    }
    return lower_atom(trimmed, bound)
}

fn print_expression(line: Text) -> Text {
    let marker = "print("
    let start = find(line, marker)
    if start < 0 {
        return ""
    }

    let expression_start = start + len(marker)
    let symbols = chars(line)
    let mut depth = 1
    let mut index = expression_start
    let mut quoted = false
    let mut escaped = false
    while index < len(symbols) {
        let symbol = symbols[index]
        if quoted {
            if escaped {
                escaped = false
            } else if symbol == "\\" {
                escaped = true
            } else if symbol == "\"" {
                quoted = false
            }
        } else if symbol == "\"" {
            quoted = true
        } else if symbol == "(" {
            depth = depth + 1
        } else if symbol == ")" {
            depth = depth - 1
            if depth == 0 {
                return trim(text_slice(line, expression_start, index))
            }
        }
        index = index + 1
    }
    return ""
}

fn binding_name(line: Text) -> Text {
    let equals = find(line, "=")
    if equals < 0 {
        return ""
    }
    let mut start = 4
    if starts_with(line, "let mut ") {
        start = 8
    }
    let name = trim(text_slice(line, start, equals))
    let colon = find(name, ":")
    if colon >= 0 {
        return trim(text_slice(name, 0, colon))
    }
    return name
}

fn binding_expression(line: Text) -> Text {
    let equals = find(line, "=")
    if equals < 0 {
        return ""
    }
    return trim(text_slice(line, equals + 1, len(line)))
}

fn binding_annotation(line: Text) -> Text {
    let equals = find(line, "=")
    if equals < 0 {
        return ""
    }
    let mut start = 4
    if starts_with(line, "let mut ") {
        start = 8
    }
    let declaration = trim(text_slice(line, start, equals))
    let colon = find(declaration, ":")
    if colon < 0 {
        return ""
    }
    return trim(text_slice(declaration, colon + 1, len(declaration)))
}

fn binding_mutable(line: Text) -> Bool {
    return starts_with(line, "let mut ")
}

fn assignment_name(line: Text) -> Text {
    let equals = find(line, "=")
    if equals < 0 {
        return ""
    }
    return trim(text_slice(line, 0, equals))
}

fn assignment_expression(line: Text) -> Text {
    let equals = find(line, "=")
    if equals < 0 {
        return ""
    }
    return trim(text_slice(line, equals + 1, len(line)))
}

# One indentation unit is four spaces.
fn indentation(units: Int) -> Text {
    let mut spaces = ""
    let mut step = 0
    while step < units {
        spaces = spaces + "    "
        step = step + 1
    }
    return spaces
}

# A Kofun block costs two C braces: the scope holding the branch chain's own
# state, then the branch. So a body at `depth` writes its statements at
# `2 * depth - 1` units, and a brace one of them opens indents by one more.
fn statement_indent(depth: Int) -> Text {
    return indentation(2 * depth - 1)
}

fn nested_indent(depth: Int) -> Text {
    return indentation(2 * depth)
}

# The bindings in scope are a `|name:Type|` run, and the scope stack lives in
# that same text: entering a block appends a `{` marker and leaving truncates
# back to the most recent one, so a name is visible exactly while its block is
# open. Names cannot contain `{`, so a marker never collides with a binding.
fn scope_enter(bound: Text) -> Text {
    return bound + "{|"
}

fn scope_leave(bound: Text) -> Text {
    let symbols = chars(bound)
    let mut found = -1
    for index in 0 .. len(symbols) {
        if symbols[index] == "{" {
            found = index
        }
    }
    if found < 0 {
        return bound
    }
    return text_slice(bound, 0, found)
}

# The open blocks of the function, innermost last: `f` is the body itself, `i` a
# branch that `else` may still follow, `e` a closing `else` that it may not, `w`
# a `while` body and `r` a `for` body. The stack length is the block depth, so
# no separate counter can disagree. Only `i` admits an `else`, so a loop is
# never mistaken for a branch a later `else` could attach to.
fn block_kind(blocks: Text) -> Text {
    if len(blocks) == 0 {
        return ""
    }
    return text_slice(blocks, len(blocks) - 1, len(blocks))
}

fn block_pop(blocks: Text) -> Text {
    if len(blocks) == 0 {
        return ""
    }
    return text_slice(blocks, 0, len(blocks) - 1)
}

# A block header carries its condition between `keyword` and a closing ` {`, so
# both fixed ends are required at once. Returning the empty condition for a line
# that only looks like a header is what makes the caller reject it: no
# expression lowers from "".
fn header_condition(line: Text, keyword: Text) -> Text {
    if !starts_with(line, keyword) {
        return ""
    }
    if len(line) < len(keyword) + 2 {
        return ""
    }
    if !(text_slice(line, len(line) - 2, len(line)) == " {") {
        return ""
    }
    return trim(text_slice(line, len(keyword), len(line) - 2))
}

# A `for` header is `for NAME in START .. END {`. Its three parts are located by
# the two fixed separators ` in ` and ` .. `, so a header missing either yields
# the empty part, and the caller refuses that: no name validates and no
# expression lowers from "". The separators are matched spaced exactly as `S`
# writes them, so `0..3` is refused rather than silently accepted.
fn range_header(line: Text) -> Text {
    if !starts_with(line, "for ") {
        return ""
    }
    if !(text_slice(line, len(line) - 2, len(line)) == " {") {
        return ""
    }
    return trim(text_slice(line, 4, len(line) - 2))
}

fn range_name(line: Text) -> Text {
    let header = range_header(line)
    let split = find(header, " in ")
    if split < 0 {
        return ""
    }
    return trim(text_slice(header, 0, split))
}

# The bound text after ` in `, from which both ends are cut. Keeping this one
# function means `range_start` and `range_end` cannot disagree about where the
# range begins.
fn range_bounds(line: Text) -> Text {
    let header = range_header(line)
    let split = find(header, " in ")
    if split < 0 {
        return ""
    }
    return text_slice(header, split + 4, len(header))
}

fn range_start(line: Text) -> Text {
    let bounds = range_bounds(line)
    let split = find(bounds, " .. ")
    if split < 0 {
        return ""
    }
    return trim(text_slice(bounds, 0, split))
}

fn range_end(line: Text) -> Text {
    let bounds = range_bounds(line)
    let split = find(bounds, " .. ")
    if split < 0 {
        return ""
    }
    return trim(text_slice(bounds, split + 4, len(bounds)))
}

fn valid_profile_source(source: Text) -> Bool {
    let functions = collect_function_signatures(source)
    if len(functions) == 0 {
        return false
    }
    let symbols = chars(source)
    let mut line_start = 0
    let mut main_headers = 0
    let mut blocks = ""
    let mut bound = functions
    let mut current_result = ""
    let mut returns = 0
    for index in 0 .. len(symbols) {
        if symbols[index] == "\n" {
            let line = trim(text_slice(source, line_start, index))
            if starts_with(line, "fn ") {
                if len(blocks) > 0 || !valid_function_header(line) {
                    return false
                }
                let name = function_name(line)
                current_result = function_result(line)
                if name == "main" {
                    if main_headers != 0 || !(current_result == "Void") ||
                       parameter_arity(function_parameters(line)) != 0 {
                        return false
                    }
                    main_headers = main_headers + 1
                }
                blocks = "f"
                bound = function_bound(functions, line)
                returns = 0
            } else if line == "}" {
                if len(blocks) == 0 {
                    return false
                }
                if len(blocks) == 1 && !(current_result == "Void") &&
                   returns == 0 {
                    return false
                }
                blocks = block_pop(blocks)
                bound = scope_leave(bound)
                if len(blocks) == 0 {
                    current_result = ""
                }
            } else if line == "} else {" {
                if !(block_kind(blocks) == "i") {
                    return false
                }
                blocks = block_pop(blocks) + "e"
                bound = scope_enter(scope_leave(bound))
            } else if starts_with(line, "} else if ") {
                if !(block_kind(blocks) == "i") {
                    return false
                }
                bound = scope_leave(bound)
                let condition = lower_expression(
                    header_condition(line, "} else if "), bound, "x",
                    statement_indent(len(blocks)))
                if !(lowered_type(condition) == "Bool") {
                    return false
                }
                bound = scope_enter(bound)
            } else if starts_with(line, "if ") {
                if len(blocks) == 0 {
                    return false
                }
                let condition = lower_expression(
                    header_condition(line, "if "), bound, "x",
                    statement_indent(len(blocks) + 1))
                if !(lowered_type(condition) == "Bool") {
                    return false
                }
                blocks = blocks + "i"
                bound = scope_enter(bound)
            } else if starts_with(line, "while ") {
                if len(blocks) == 0 {
                    return false
                }
                let condition = lower_expression(
                    header_condition(line, "while "), bound, "x",
                    statement_indent(len(blocks) + 1))
                if !(lowered_type(condition) == "Bool") {
                    return false
                }
                blocks = blocks + "w"
                bound = scope_enter(bound)
            } else if starts_with(line, "for ") {
                if len(blocks) == 0 {
                    return false
                }
                let name = range_name(line)
                if !valid_name(name) || name == "true" || name == "false" ||
                   len(bound_type(bound, name)) > 0 {
                    return false
                }
                let from = lower_expression(range_start(line), bound, "xl",
                                            nested_indent(len(blocks)))
                let to = lower_expression(range_end(line), bound, "xr",
                                          nested_indent(len(blocks)))
                if !(lowered_type(from) == "Int") ||
                   !(lowered_type(to) == "Int") {
                    return false
                }
                blocks = blocks + "r"
                bound = scope_enter(bound) + name + ":Int|"
            } else if starts_with(line, "let ") {
                if len(blocks) == 0 {
                    return false
                }
                let name = binding_name(line)
                if !valid_name(name) || name == "true" || name == "false" ||
                   len(bound_type(bound, name)) > 0 {
                    return false
                }
                let value = lower_expression(binding_expression(line), bound,
                                             "x", nested_indent(len(blocks)))
                let kind = lowered_type(value)
                if len(kind) == 0 || kind == "Void" {
                    return false
                }
                let annotation = binding_annotation(line)
                if len(annotation) > 0 && !(annotation == kind) {
                    return false
                }
                bound = bound + name + ":" + kind
                if binding_mutable(line) {
                    bound = bound + "!"
                }
                bound = bound + "|"
            } else if line == "return" || starts_with(line, "return ") {
                if len(blocks) == 0 {
                    return false
                }
                if line == "return" {
                    if !(current_result == "Void") {
                        return false
                    }
                } else {
                    let value = lower_expression(
                        trim(text_slice(line, 7, len(line))), bound, "r",
                        nested_indent(len(blocks)))
                    if !(lowered_type(value) == current_result) ||
                       current_result == "Void" {
                        return false
                    }
                }
                returns = returns + 1
            } else if starts_with(line, "print(") {
                if len(blocks) == 0 {
                    return false
                }
                let kind = lowered_type(lower_expression(
                    print_expression(line), bound, "x",
                    nested_indent(len(blocks))))
                if !(kind == "Int") && !(kind == "Text") {
                    return false
                }
            } else if find(line, " = ") > 0 {
                if len(blocks) == 0 {
                    return false
                }
                let name = assignment_name(line)
                let value = lower_expression(assignment_expression(line),
                                             bound, "a",
                                             nested_indent(len(blocks)))
                if !valid_name(name) || !bound_mutable(bound, name) ||
                   !(lowered_type(value) == bound_type(bound, name)) {
                    return false
                }
            } else if find(line, "(") > 0 {
                if len(blocks) == 0 {
                    return false
                }
                let value = lower_expression(line, bound, "x",
                                             nested_indent(len(blocks)))
                if !(lowered_type(value) == "Void") {
                    return false
                }
            } else {
                return false
            }
            line_start = index + 1
        }
    }
    return main_headers == 1 && len(blocks) == 0
}

fn valid_source(source: Text) -> Bool {
    let symbols = chars(source)
    let mut line_start = 0
    let mut prints = 0
    let mut main_headers = 0
    let mut blocks = ""
    let mut bound = "|"
    for index in 0 .. len(symbols) {
        if symbols[index] == "\n" {
            let line = trim(text_slice(source, line_start, index))
            if len(line) == 0 || starts_with(line, "#") {
                # Comments and blank lines do not change the structural state.
            } else if line == "fn main() {" {
                if main_headers != 0 || len(blocks) > 0 {
                    return false
                }
                main_headers = main_headers + 1
                blocks = "f"
                bound = scope_enter(bound)
            } else if line == "}" {
                if len(blocks) == 0 {
                    return false
                }
                blocks = block_pop(blocks)
                bound = scope_leave(bound)
            } else if line == "} else {" {
                if !(block_kind(blocks) == "i") {
                    return false
                }
                blocks = block_pop(blocks) + "e"
                bound = scope_enter(scope_leave(bound))
            } else if starts_with(line, "} else if ") {
                if !(block_kind(blocks) == "i") {
                    return false
                }
                # The condition belongs to the enclosing scope, not to the
                # branch it closes, so it is checked after leaving that branch.
                bound = scope_leave(bound)
                let condition = lower_expression(
                    header_condition(line, "} else if "), bound, "x",
                    statement_indent(len(blocks)))
                if !(lowered_type(condition) == "Bool") {
                    return false
                }
                bound = scope_enter(bound)
            } else if starts_with(line, "if ") {
                if len(blocks) == 0 {
                    return false
                }
                let condition = lower_expression(
                    header_condition(line, "if "), bound, "x",
                    statement_indent(len(blocks) + 1))
                if !(lowered_type(condition) == "Bool") {
                    return false
                }
                blocks = blocks + "i"
                bound = scope_enter(bound)
            } else if starts_with(line, "while ") {
                if len(blocks) == 0 {
                    return false
                }
                let condition = lower_expression(
                    header_condition(line, "while "), bound, "x",
                    statement_indent(len(blocks) + 1))
                if !(lowered_type(condition) == "Bool") {
                    return false
                }
                blocks = blocks + "w"
                bound = scope_enter(bound)
            } else if starts_with(line, "for ") {
                if len(blocks) == 0 {
                    return false
                }
                let name = range_name(line)
                if !valid_name(name) || name == "true" || name == "false" {
                    return false
                }
                # The bound name is an ordinary binding, so it may not shadow
                # one already visible, exactly as a `let` may not.
                if len(bound_type(bound, name)) > 0 {
                    return false
                }
                # Both ends belong to the enclosing scope and are evaluated
                # once, before the bound name exists, so neither end can name
                # it. They take different lowering paths because both sets of
                # statements land in one C scope and would otherwise share
                # temporaries.
                let from = lower_expression(range_start(line), bound, "xl",
                                            nested_indent(len(blocks)))
                let to = lower_expression(range_end(line), bound, "xr",
                                          nested_indent(len(blocks)))
                if !(lowered_type(from) == "Int") ||
                   !(lowered_type(to) == "Int") {
                    return false
                }
                blocks = blocks + "r"
                bound = scope_enter(bound) + name + ":Int|"
            } else if starts_with(line, "let ") {
                if len(blocks) == 0 {
                    return false
                }
                let name = binding_name(line)
                if !valid_name(name) || name == "true" || name == "false" {
                    return false
                }
                # One binding per visible name: the language rejects shadowing,
                # so the seed rejects it too. A name freed by its block's `}` is
                # available again.
                if len(bound_type(bound, name)) > 0 {
                    return false
                }
                let value = lower_expression(binding_expression(line), bound,
                                             "x", nested_indent(len(blocks)))
                let kind = lowered_type(value)
                if len(kind) == 0 || kind == "Void" {
                    return false
                }
                let declaration = trim(text_slice(line, 4, find(line, "=")))
                let annotation = binding_annotation(line)
                if find(declaration, ":") >= 0 && !(annotation == kind) {
                    return false
                }
                bound = bound + name + ":" + kind + "|"
            } else if starts_with(line, "print(") {
                if len(blocks) == 0 {
                    return false
                }
                let expression = print_expression(line)
                let kind = lowered_type(lower_expression(
                    expression, bound, "x", nested_indent(len(blocks))))
                if !(kind == "Int") && !(kind == "Text") {
                    return false
                }
                prints = prints + 1
            } else if starts_with(line, "write_text(") {
                if len(blocks) == 0 {
                    return false
                }
                let value = lower_expression(line, bound, "x",
                                             nested_indent(len(blocks)))
                if !(lowered_type(value) == "Void") {
                    return false
                }
            } else {
                return false
            }
            line_start = index + 1
        }
    }
    return main_headers == 1 && len(blocks) == 0 && prints > 0
}

# The second structural walk. It repeats the first one's block and scope
# bookkeeping rather than sharing it, so `bound` resolves every name to the same
# binding both walks agreed on, and it only runs on a source `valid_source`
# already accepted.
#
# A branch chain becomes one C scope holding `kt_taken`, the flag saying an
# earlier branch already ran, and `kt_cond`, the current condition. Each Kofun
# block-opening line opens exactly one branch brace and each `}` closes exactly
# one, so `else if` never accumulates braces the closing line has to count. A
# nested chain declares its own pair inside its own scope.
fn emit_statements(source: Text) -> Text {
    let symbols = chars(source)
    let mut line_start = 0
    let mut emitted = ""
    let mut bound = "|"
    let mut blocks = ""
    for index in 0 .. len(symbols) {
        if symbols[index] == "\n" {
            let line = trim(text_slice(source, line_start, index))
            if line == "fn main() {" {
                blocks = "f"
                bound = scope_enter(bound)
            } else if line == "}" {
                # Which kind of block closes decides only what the closing line
                # discards, so the kind is read before the pop that forgets it.
                # Every block costs the same two braces either way.
                let kind = block_kind(blocks)
                let depth = len(blocks)
                blocks = block_pop(blocks)
                bound = scope_leave(bound)
                if len(blocks) > 0 {
                    if kind == "w" || kind == "r" {
                        # A loop has no branch chain, so there is no `kt_taken`.
                        emitted = emitted +
                        nested_indent(depth - 1) + "}\n" +
                        statement_indent(depth - 1) + "}\n"
                    } else {
                        emitted = emitted +
                        nested_indent(depth - 1) + "}\n" +
                        nested_indent(depth - 1) + "(void)kt_taken;\n" +
                        statement_indent(depth - 1) + "}\n"
                    }
                }
            } else if line == "} else {" {
                let depth = len(blocks)
                blocks = block_pop(blocks) + "e"
                bound = scope_enter(scope_leave(bound))
                emitted = emitted +
                nested_indent(depth - 1) + "}\n" +
                nested_indent(depth - 1) + "if (!kt_taken) {\n"
            } else if starts_with(line, "} else if ") {
                let depth = len(blocks)
                bound = scope_leave(bound)
                let condition = lower_expression(
                    header_condition(line, "} else if "), bound, "x",
                    statement_indent(depth))
                bound = scope_enter(bound)
                # A skipped `else if` must not evaluate its condition, so the
                # condition statements sit inside the `kt_taken` guard and the
                # skipped path assigns a false condition instead.
                emitted = emitted +
                nested_indent(depth - 1) + "}\n" +
                nested_indent(depth - 1) + "if (!kt_taken) {\n" +
                lowered_statements(condition) +
                statement_indent(depth) + "kt_cond = " +
                lowered_operand(condition) + ";\n" +
                statement_indent(depth) + "if (failed) return 1;\n" +
                nested_indent(depth - 1) + "} else {\n" +
                statement_indent(depth) + "kt_cond = false;\n" +
                nested_indent(depth - 1) + "}\n" +
                nested_indent(depth - 1) + "if (kt_cond) {\n" +
                statement_indent(depth) + "kt_taken = true;\n"
            } else if starts_with(line, "if ") {
                let depth = len(blocks)
                let condition = lower_expression(
                    header_condition(line, "if "), bound, "x",
                    statement_indent(depth + 1))
                blocks = blocks + "i"
                bound = scope_enter(bound)
                emitted = emitted +
                statement_indent(depth) + "{\n" +
                nested_indent(depth) + "bool kt_taken = false;\n" +
                nested_indent(depth) + "bool kt_cond;\n" +
                nested_indent(depth) + "{\n" +
                lowered_statements(condition) +
                statement_indent(depth + 1) + "kt_cond = " +
                lowered_operand(condition) + ";\n" +
                nested_indent(depth) + "}\n" +
                nested_indent(depth) + "if (failed) return 1;\n" +
                nested_indent(depth) + "if (kt_cond) {\n" +
                statement_indent(depth + 1) + "kt_taken = true;\n"
            } else if starts_with(line, "while ") {
                let depth = len(blocks)
                let condition = lower_expression(
                    header_condition(line, "while "), bound, "x",
                    statement_indent(depth + 1))
                blocks = blocks + "w"
                bound = scope_enter(bound)
                # The condition is re-evaluated on every iteration. A C `while`
                # header holds one expression, not the statement sequence a
                # lowered condition is, so the condition becomes the first
                # statements of a `while (true)` body and a `break` carries its
                # result. That keeps one evaluation per iteration, where a
                # duplicated condition would cost two.
                emitted = emitted +
                statement_indent(depth) + "{\n" +
                nested_indent(depth) + "bool kt_cond;\n" +
                nested_indent(depth) + "while (true) {\n" +
                lowered_statements(condition) +
                statement_indent(depth + 1) + "kt_cond = " +
                lowered_operand(condition) + ";\n" +
                statement_indent(depth + 1) + "if (failed) return 1;\n" +
                statement_indent(depth + 1) + "if (!kt_cond) break;\n"
            } else if starts_with(line, "for ") {
                let depth = len(blocks)
                let name = range_name(line)
                let from = lower_expression(range_start(line), bound, "xl",
                                            nested_indent(depth))
                let to = lower_expression(range_end(line), bound, "xr",
                                          nested_indent(depth))
                blocks = blocks + "r"
                bound = scope_enter(bound) + name + ":Int|"
                # Both ends are evaluated once, into the enclosing scope, before
                # the loop begins: re-evaluating `to` per iteration would let a
                # failing end expression report a diagnostic more than once and
                # would make the trip count depend on the body.
                emitted = emitted +
                statement_indent(depth) + "{\n" +
                lowered_statements(from) +
                nested_indent(depth) + "int64_t kt_from = " +
                lowered_operand(from) + ";\n" +
                lowered_statements(to) +
                nested_indent(depth) + "int64_t kt_to = " +
                lowered_operand(to) + ";\n" +
                nested_indent(depth) + "if (failed) return 1;\n" +
                nested_indent(depth) + "for (int64_t kf_" + name +
                " = kt_from; kf_" + name + " < kt_to; ++kf_" + name + ") {\n" +
                statement_indent(depth + 1) + "(void)kf_" + name + ";\n"
            } else if starts_with(line, "let ") {
                let depth = len(blocks)
                let name = binding_name(line)
                let value = lower_expression(binding_expression(line), bound,
                                             "x", nested_indent(depth))
                let kind = lowered_type(value)
                let mut c_type = "int64_t"
                if kind == "Bool" {
                    c_type = "bool"
                } else if kind == "Text" {
                    c_type = "const char *"
                } else if kind == "List[Text]" {
                    c_type = "KofunTextList"
                }
                emitted = emitted +
                statement_indent(depth) + c_type + " kf_" + name + ";\n" +
                statement_indent(depth) + "{\n" +
                lowered_statements(value) +
                nested_indent(depth) + "kf_" + name + " = " +
                lowered_operand(value) + ";\n" +
                statement_indent(depth) + "}\n" +
                statement_indent(depth) + "if (failed) return 1;\n" +
                statement_indent(depth) + "(void)kf_" + name + ";\n"
                bound = bound + name + ":" + kind + "|"
            } else if starts_with(line, "print(") {
                let depth = len(blocks)
                let value = lower_expression(print_expression(line), bound, "x",
                                             nested_indent(depth))
                let kind = lowered_type(value)
                emitted = emitted +
                statement_indent(depth) + "{\n" +
                lowered_statements(value)
                if kind == "Text" {
                    emitted = emitted +
                    nested_indent(depth) + "const char * value = " +
                    lowered_operand(value) + ";\n" +
                    nested_indent(depth) + "if (failed) return 1;\n" +
                    nested_indent(depth) + "fputs(value, stdout);\n" +
                    nested_indent(depth) + "fputc('\\n', stdout);\n"
                } else {
                    emitted = emitted +
                    nested_indent(depth) + "int64_t value = " +
                    lowered_operand(value) + ";\n" +
                    nested_indent(depth) + "if (failed) return 1;\n" +
                    nested_indent(depth) +
                    "printf(\"%\" PRId64 \"\\n\", value);\n"
                }
                emitted = emitted + statement_indent(depth) + "}\n"
            } else if starts_with(line, "write_text(") {
                let depth = len(blocks)
                let value = lower_expression(line, bound, "x",
                                             nested_indent(depth))
                emitted = emitted +
                statement_indent(depth) + "{\n" +
                lowered_statements(value) +
                nested_indent(depth) + "if (failed) return 1;\n" +
                statement_indent(depth) + "}\n"
            }
            line_start = index + 1
        }
    }
    return emitted
}

fn emitted_parameters(line: Text) -> Text {
    let parameters = function_parameters(line)
    let arity = parameter_arity(parameters)
    if arity == 0 {
        return "void"
    }
    let mut emitted = ""
    for index in 0 .. arity {
        if index > 0 {
            emitted = emitted + ", "
        }
        emitted = emitted + emitted_c_type(parameter_type(parameters, index)) +
        " kf_" + parameter_name(parameters, index)
    }
    return emitted
}

fn emit_function_prototypes(source: Text) -> Text {
    let symbols = chars(source)
    let mut line_start = 0
    let mut emitted = ""
    for index in 0 .. len(symbols) {
        if symbols[index] == "\n" {
            let line = trim(text_slice(source, line_start, index))
            if starts_with(line, "fn ") && !(function_name(line) == "main") {
                emitted = emitted + "static " +
                emitted_c_type(function_result(line)) + " kf_" +
                function_name(line) + "(" + emitted_parameters(line) + ");\n"
            }
            line_start = index + 1
        }
    }
    return emitted + "\n"
}

fn emit_function_uses(source: Text) -> Text {
    let symbols = chars(source)
    let mut line_start = 0
    let mut emitted = ""
    for index in 0 .. len(symbols) {
        if symbols[index] == "\n" {
            let line = trim(text_slice(source, line_start, index))
            if starts_with(line, "fn ") && !(function_name(line) == "main") {
                emitted = emitted + "    (void)kf_" + function_name(line) +
                ";\n"
            }
            line_start = index + 1
        }
    }
    return emitted
}

// The four control-header branches of emit_profile_program carry its longest
// concatenations. They are lifted out so the dispatch loop stays inside the
// bounded lexical-use limit the Stage 2 resolver enforces per function
// (E2S35); each helper is pure text and changes no emitted byte.
fn emit_profile_else_if(condition: Text, depth: Int, result: Text) -> Text {
    return nested_indent(depth - 1) + "}\n" +
    nested_indent(depth - 1) + "if (!kt_taken) {\n" +
    lowered_statements(condition) +
    statement_indent(depth) + "kt_cond = " +
    lowered_operand(condition) + ";\n" +
    statement_indent(depth) + failure_return(result) +
    nested_indent(depth - 1) + "} else {\n" +
    statement_indent(depth) + "kt_cond = false;\n" +
    nested_indent(depth - 1) + "}\n" +
    nested_indent(depth - 1) + "if (kt_cond) {\n" +
    statement_indent(depth) + "kt_taken = true;\n"
}

fn emit_profile_if(condition: Text, depth: Int, result: Text) -> Text {
    return statement_indent(depth) + "{\n" +
    nested_indent(depth) + "bool kt_taken = false;\n" +
    nested_indent(depth) + "bool kt_cond;\n" +
    nested_indent(depth) + "{\n" +
    lowered_statements(condition) +
    statement_indent(depth + 1) + "kt_cond = " +
    lowered_operand(condition) + ";\n" +
    nested_indent(depth) + "}\n" +
    nested_indent(depth) + failure_return(result) +
    nested_indent(depth) + "if (kt_cond) {\n" +
    statement_indent(depth + 1) + "kt_taken = true;\n"
}

fn emit_profile_while(condition: Text, depth: Int, result: Text) -> Text {
    return statement_indent(depth) + "{\n" +
    nested_indent(depth) + "bool kt_cond;\n" +
    nested_indent(depth) + "while (true) {\n" +
    lowered_statements(condition) +
    statement_indent(depth + 1) + "kt_cond = " +
    lowered_operand(condition) + ";\n" +
    statement_indent(depth + 1) + failure_return(result) +
    statement_indent(depth + 1) + "if (!kt_cond) break;\n"
}

fn emit_profile_for(from: Text, to: Text, name: Text, depth: Int,
                    result: Text) -> Text {
    return statement_indent(depth) + "{\n" +
    lowered_statements(from) +
    nested_indent(depth) + "int64_t kt_from = " +
    lowered_operand(from) + ";\n" +
    lowered_statements(to) +
    nested_indent(depth) + "int64_t kt_to = " +
    lowered_operand(to) + ";\n" +
    nested_indent(depth) + failure_return(result) +
    nested_indent(depth) + "for (int64_t kf_" + name +
    " = kt_from; kf_" + name + " < kt_to; ++kf_" + name + ") {\n" +
    statement_indent(depth + 1) + "(void)kf_" + name + ";\n"
}

fn emit_profile_program(source: Text, main_prelude: Text) -> Text {
    let functions = collect_function_signatures(source)
    let symbols = chars(source)
    let mut line_start = 0
    let mut emitted = emit_function_prototypes(source)
    let mut bound = functions
    let mut blocks = ""
    let mut current_result = ""
    let mut current_name = ""
    for index in 0 .. len(symbols) {
        if symbols[index] == "\n" {
            let line = trim(text_slice(source, line_start, index))
            if starts_with(line, "fn ") {
                current_name = function_name(line)
                current_result = function_result(line)
                blocks = "f"
                bound = function_bound(functions, line)
                if current_name == "main" {
                    emitted = emitted + "int main(int argc, char **argv) {\n" +
                    "    (void)argc;\n" +
                    "    (void)argv;\n" +
                    main_prelude + emit_function_uses(source)
                } else {
                    emitted = emitted + "static " +
                    emitted_c_type(current_result) + " kf_" + current_name +
                    "(" + emitted_parameters(line) + ") {\n"
                    let parameters = function_parameters(line)
                    for parameter in 0 .. parameter_arity(parameters) {
                        emitted = emitted + "    (void)kf_" +
                        parameter_name(parameters, parameter) + ";\n"
                    }
                }
            } else if line == "}" {
                let kind = block_kind(blocks)
                let depth = len(blocks)
                blocks = block_pop(blocks)
                bound = scope_leave(bound)
                if len(blocks) == 0 {
                    if current_name == "main" {
                        emitted = emitted + "    return 0;\n}\n\n"
                    } else if current_result == "Void" {
                        emitted = emitted + "    return;\n}\n\n"
                    } else {
                        emitted = emitted + "}\n\n"
                    }
                    current_name = ""
                    current_result = ""
                } else if kind == "w" || kind == "r" {
                    emitted = emitted +
                    nested_indent(depth - 1) + "}\n" +
                    statement_indent(depth - 1) + "}\n"
                } else {
                    emitted = emitted +
                    nested_indent(depth - 1) + "}\n" +
                    nested_indent(depth - 1) + "(void)kt_taken;\n" +
                    statement_indent(depth - 1) + "}\n"
                }
            } else if line == "} else {" {
                let depth = len(blocks)
                blocks = block_pop(blocks) + "e"
                bound = scope_enter(scope_leave(bound))
                emitted = emitted +
                nested_indent(depth - 1) + "}\n" +
                nested_indent(depth - 1) + "if (!kt_taken) {\n"
            } else if starts_with(line, "} else if ") {
                let depth = len(blocks)
                bound = scope_leave(bound)
                let condition = lower_expression(
                    header_condition(line, "} else if "), bound, "x",
                    statement_indent(depth))
                bound = scope_enter(bound)
                emitted = emitted +
                emit_profile_else_if(condition, depth, current_result)
            } else if starts_with(line, "if ") {
                let depth = len(blocks)
                let condition = lower_expression(
                    header_condition(line, "if "), bound, "x",
                    statement_indent(depth + 1))
                blocks = blocks + "i"
                bound = scope_enter(bound)
                emitted = emitted +
                emit_profile_if(condition, depth, current_result)
            } else if starts_with(line, "while ") {
                let depth = len(blocks)
                let condition = lower_expression(
                    header_condition(line, "while "), bound, "x",
                    statement_indent(depth + 1))
                blocks = blocks + "w"
                bound = scope_enter(bound)
                emitted = emitted +
                emit_profile_while(condition, depth, current_result)
            } else if starts_with(line, "for ") {
                let depth = len(blocks)
                let name = range_name(line)
                let from = lower_expression(range_start(line), bound, "xl",
                                            nested_indent(depth))
                let to = lower_expression(range_end(line), bound, "xr",
                                          nested_indent(depth))
                blocks = blocks + "r"
                bound = scope_enter(bound) + name + ":Int|"
                emitted = emitted +
                emit_profile_for(from, to, name, depth, current_result)
            } else if starts_with(line, "let ") {
                let depth = len(blocks)
                let name = binding_name(line)
                let value = lower_expression(binding_expression(line), bound,
                                             "x", nested_indent(depth))
                let kind = lowered_type(value)
                emitted = emitted +
                statement_indent(depth) + emitted_c_type(kind) + " kf_" +
                name + ";\n" +
                statement_indent(depth) + "{\n" +
                lowered_statements(value) +
                nested_indent(depth) + "kf_" + name + " = " +
                lowered_operand(value) + ";\n" +
                statement_indent(depth) + "}\n" +
                statement_indent(depth) + failure_return(current_result) +
                statement_indent(depth) + "(void)kf_" + name + ";\n"
                bound = bound + name + ":" + kind
                if binding_mutable(line) {
                    bound = bound + "!"
                }
                bound = bound + "|"
            } else if line == "return" || starts_with(line, "return ") {
                let depth = len(blocks)
                if line == "return" {
                    if current_name == "main" {
                        emitted = emitted + statement_indent(depth) +
                        "return 0;\n"
                    } else {
                        emitted = emitted + statement_indent(depth) +
                        "return;\n"
                    }
                } else {
                    let value = lower_expression(
                        trim(text_slice(line, 7, len(line))), bound, "r",
                        nested_indent(depth))
                    emitted = emitted +
                    statement_indent(depth) + "{\n" +
                    lowered_statements(value) +
                    nested_indent(depth) + failure_return(current_result) +
                    nested_indent(depth) + "return " +
                    lowered_operand(value) + ";\n" +
                    statement_indent(depth) + "}\n"
                }
            } else if starts_with(line, "print(") {
                let depth = len(blocks)
                let value = lower_expression(print_expression(line), bound,
                                             "x", nested_indent(depth))
                let kind = lowered_type(value)
                emitted = emitted +
                statement_indent(depth) + "{\n" +
                lowered_statements(value) +
                nested_indent(depth) + failure_return(current_result)
                if kind == "Text" {
                    emitted = emitted +
                    nested_indent(depth) + "fputs(" +
                    lowered_operand(value) + ", stdout);\n" +
                    nested_indent(depth) + "fputc('\\n', stdout);\n"
                } else {
                    emitted = emitted +
                    nested_indent(depth) + "printf(\"%\" PRId64 \"\\n\", " +
                    lowered_operand(value) + ");\n"
                }
                emitted = emitted + statement_indent(depth) + "}\n"
            } else if find(line, " = ") > 0 {
                let depth = len(blocks)
                let name = assignment_name(line)
                let value = lower_expression(assignment_expression(line),
                                             bound, "a",
                                             nested_indent(depth))
                emitted = emitted +
                statement_indent(depth) + "{\n" +
                lowered_statements(value) +
                nested_indent(depth) + "kf_" + name + " = " +
                lowered_operand(value) + ";\n" +
                statement_indent(depth) + "}\n" +
                statement_indent(depth) + failure_return(current_result)
            } else if find(line, "(") > 0 {
                let depth = len(blocks)
                let value = lower_expression(line, bound, "x",
                                             nested_indent(depth))
                emitted = emitted +
                statement_indent(depth) + "{\n" +
                lowered_statements(value) +
                nested_indent(depth) + failure_return(current_result) +
                statement_indent(depth) + "}\n"
            }
            line_start = index + 1
        }
    }
    return emitted
}

fn emit_c(source: Text, profile: Bool) -> Text {
    let mut statements = emit_statements(source)
    if profile {
        statements = emit_profile_program(source, "")
    }
    let uses_profile_builtins =
    find(statements, "kofun_rt_args(") >= 0 ||
    find(statements, "kofun_rt_fail(") >= 0 ||
    find(statements, "kofun_rt_text_contains(") >= 0 ||
    find(statements, "kofun_rt_find(") >= 0 ||
    find(statements, "kofun_rt_is_digit(") >= 0 ||
    find(statements, "kofun_rt_is_space(") >= 0 ||
    find(statements, "kofun_rt_is_xid_continue(") >= 0 ||
    find(statements, "kofun_rt_text_len(") >= 0 ||
    find(statements, "kofun_rt_read_text(") >= 0 ||
    find(statements, "kofun_rt_starts_with(") >= 0 ||
    find(statements, "kofun_rt_text_slice(") >= 0 ||
    find(statements, "kofun_rt_trim(") >= 0 ||
    find(statements, "kofun_rt_validate_unicode_source(") >= 0 ||
    find(statements, "kofun_rt_write_text(") >= 0
    let mut text_headers = ""
    let mut text_runtime = ""
    let mut text_main = ""
    let mut text_index_runtime = ""
    let mut text_index_main = ""
    let mut list_runtime = ""
    let mut list_main = ""
    let mut profile_headers = ""
    let mut profile_runtime = ""
    let mut profile_main = ""
    let mut fail_runtime = ""
    let mut main_signature = "int main(void) {\n"
    if uses_profile_builtins {
        profile_headers =
        "#include <ctype.h>\n" +
        "#include \"kofun_unicode.c\"\n"
    }
    if find(statements, "kofun_rt_args(") >= 0 {
        main_signature = "int main(int argc, char **argv) {\n"
    }
    if find(statements, "kofun_rt_fail(") >= 0 {
        fail_runtime =
        "static void kofun_rt_fail(void) {\n" +
        "    exit(1);\n" +
        "}\n\n"
    }
    if find(statements, "const char *") >= 0 ||
       find(statements, "kofun_rt_text_") >= 0 ||
       find(statements, "KofunTextList") >= 0 ||
       uses_profile_builtins {
        text_headers =
        "#include <stdlib.h>\n" +
        "#include <string.h>\n"
        text_runtime =
        "typedef struct KofunTextAllocation {\n" +
        "    struct KofunTextAllocation *next;\n" +
        "    char bytes[];\n" +
        "} KofunTextAllocation;\n\n" +
        "static KofunTextAllocation *kofun_rt_text_allocations;\n\n" +
        "static void kofun_rt_text_cleanup(void) {\n" +
        "    while (kofun_rt_text_allocations != NULL) {\n" +
        "        KofunTextAllocation *allocation = kofun_rt_text_allocations;\n" +
        "        kofun_rt_text_allocations = allocation->next;\n" +
        "        free(allocation);\n" +
        "    }\n" +
        "}\n\n" +
        "static const char *kofun_rt_text_concat(const char *left, const char *right) {\n" +
        "    size_t left_size = strlen(left);\n" +
        "    size_t right_size = strlen(right);\n" +
        "    if (right_size == SIZE_MAX || left_size > SIZE_MAX - right_size - 1) {\n" +
        "        runtime_error(\"error[R010]: Text concatenation is too large\");\n" +
        "        return \"\";\n" +
        "    }\n" +
        "    size_t payload_size = left_size + right_size + 1;\n" +
        "    if (payload_size > SIZE_MAX - sizeof(KofunTextAllocation)) {\n" +
        "        runtime_error(\"error[R010]: Text concatenation is too large\");\n" +
        "        return \"\";\n" +
        "    }\n" +
        "    KofunTextAllocation *allocation =\n" +
        "        malloc(sizeof(KofunTextAllocation) + payload_size);\n" +
        "    if (allocation == NULL) {\n" +
        "        runtime_error(\"error[R010]: Text allocation failed\");\n" +
        "        return \"\";\n" +
        "    }\n" +
        "    memcpy(allocation->bytes, left, left_size);\n" +
        "    memcpy(allocation->bytes + left_size, right, right_size);\n" +
        "    allocation->bytes[left_size + right_size] = '\\0';\n" +
        "    allocation->next = kofun_rt_text_allocations;\n" +
        "    kofun_rt_text_allocations = allocation;\n" +
        "    return allocation->bytes;\n" +
        "}\n\n" +
        "static bool kofun_rt_text_equal(const char *left, const char *right) {\n" +
        "    return strcmp(left, right) == 0;\n" +
        "}\n\n"
        text_main =
        "    if (atexit(kofun_rt_text_cleanup) != 0) {\n" +
        "        runtime_error(\"error[R010]: Text cleanup registration failed\");\n" +
        "        return 1;\n" +
        "    }\n" +
        "    (void)kofun_rt_text_concat;\n" +
        "    (void)kofun_rt_text_equal;\n"
    }
    if find(statements, "kofun_rt_text_index") >= 0 {
        text_index_runtime =
        "static const char *kofun_rt_text_index(const char *value, int64_t index) {\n" +
        "    size_t length = strlen(value);\n" +
        "    if (index < 0 || (uint64_t)index >= (uint64_t)length) {\n" +
        "        runtime_error(\"error[R010]: Text index out of bounds\");\n" +
        "        return \"\";\n" +
        "    }\n" +
        "    char character[2] = { value[index], '\\0' };\n" +
        "    return kofun_rt_text_concat(\"\", character);\n" +
        "}\n\n"
        text_index_main =
        "    (void)kofun_rt_text_index;\n"
    }
    if find(statements, "KofunTextList") >= 0 || uses_profile_builtins {
        list_runtime =
        "typedef struct {\n" +
        "    int64_t len;\n" +
        "    const char **items;\n" +
        "} KofunTextList;\n\n" +
        "typedef struct KofunTextListAllocation {\n" +
        "    struct KofunTextListAllocation *next;\n" +
        "    const char *items[];\n" +
        "} KofunTextListAllocation;\n\n" +
        "static KofunTextListAllocation *kofun_rt_text_list_allocations;\n\n" +
        "static void kofun_rt_text_list_cleanup(void) {\n" +
        "    while (kofun_rt_text_list_allocations != NULL) {\n" +
        "        KofunTextListAllocation *allocation =\n" +
        "            kofun_rt_text_list_allocations;\n" +
        "        kofun_rt_text_list_allocations = allocation->next;\n" +
        "        free(allocation);\n" +
        "    }\n" +
        "}\n\n" +
        "static KofunTextList kofun_rt_empty_text_list(void) {\n" +
        "    KofunTextList result = { 0, NULL };\n" +
        "    return result;\n" +
        "}\n\n" +
        "static KofunTextList kofun_rt_chars(const char *value) {\n" +
        "    size_t length = strlen(value);\n" +
        "    if ((uint64_t)length > (uint64_t)INT64_MAX ||\n" +
        "        length > (SIZE_MAX - sizeof(KofunTextListAllocation)) /\n" +
        "            sizeof(const char *)) {\n" +
        "        runtime_error(\"error[R010]: List[Text] allocation is too large\");\n" +
        "        return kofun_rt_empty_text_list();\n" +
        "    }\n" +
        "    KofunTextListAllocation *allocation = malloc(\n" +
        "        sizeof(KofunTextListAllocation) + length * sizeof(const char *));\n" +
        "    if (allocation == NULL) {\n" +
        "        runtime_error(\"error[R010]: List[Text] allocation failed\");\n" +
        "        return kofun_rt_empty_text_list();\n" +
        "    }\n" +
        "    allocation->next = kofun_rt_text_list_allocations;\n" +
        "    kofun_rt_text_list_allocations = allocation;\n" +
        "    for (size_t index = 0; index < length; ++index) {\n" +
        "        char character[2] = { value[index], '\\0' };\n" +
        "        allocation->items[index] =\n" +
        "            kofun_rt_text_concat(\"\", character);\n" +
        "        if (failed) return kofun_rt_empty_text_list();\n" +
        "    }\n" +
        "    KofunTextList result = {\n" +
        "        (int64_t)length,\n" +
        "        allocation->items,\n" +
        "    };\n" +
        "    return result;\n" +
        "}\n\n" +
        "static int64_t kofun_rt_text_list_len(KofunTextList values) {\n" +
        "    return values.len;\n" +
        "}\n\n" +
        "static const char *kofun_rt_text_list_get(\n" +
        "    KofunTextList values,\n" +
        "    int64_t index\n" +
        ") {\n" +
        "    if (index < 0 || index >= values.len) {\n" +
        "        runtime_error(\"error[R010]: List[Text] index out of bounds\");\n" +
        "        return \"\";\n" +
        "    }\n" +
        "    return values.items[index];\n" +
        "}\n\n"
        list_main =
        "    if (atexit(kofun_rt_text_list_cleanup) != 0) {\n" +
        "        runtime_error(\"error[R010]: List[Text] cleanup registration failed\");\n" +
        "        return 1;\n" +
        "    }\n" +
        "    (void)kofun_rt_chars;\n" +
        "    (void)kofun_rt_text_list_len;\n" +
        "    (void)kofun_rt_text_list_get;\n"
    }
    if uses_profile_builtins {
        profile_runtime =
        "static char *kofun_rt_profile_text_allocate(size_t length) {\n" +
        "    if (length == SIZE_MAX ||\n" +
        "        length + 1 > SIZE_MAX - sizeof(KofunTextAllocation)) {\n" +
        "        runtime_error(\"error[R010]: Text allocation is too large\");\n" +
        "        return NULL;\n" +
        "    }\n" +
        "    KofunTextAllocation *allocation =\n" +
        "        malloc(sizeof(KofunTextAllocation) + length + 1);\n" +
        "    if (allocation == NULL) {\n" +
        "        runtime_error(\"error[R010]: Text allocation failed\");\n" +
        "        return NULL;\n" +
        "    }\n" +
        "    allocation->bytes[length] = '\\0';\n" +
        "    allocation->next = kofun_rt_text_allocations;\n" +
        "    kofun_rt_text_allocations = allocation;\n" +
        "    return allocation->bytes;\n" +
        "}\n\n" +
        "static const char *kofun_rt_profile_copy_n(\n" +
        "    const char *value,\n" +
        "    size_t length\n" +
        ") {\n" +
        "    char *result = kofun_rt_profile_text_allocate(length);\n" +
        "    if (result == NULL) return \"\";\n" +
        "    if (length > 0) memcpy(result, value, length);\n" +
        "    return result;\n" +
        "}\n\n" +
        "static KofunTextList kofun_rt_args(int argc, char **argv) {\n" +
        "    if (argc <= 1) return kofun_rt_empty_text_list();\n" +
        "    size_t length = (size_t)(argc - 1);\n" +
        "    if (length > (SIZE_MAX - sizeof(KofunTextListAllocation)) /\n" +
        "            sizeof(const char *)) {\n" +
        "        runtime_error(\"error[R010]: argument List[Text] is too large\");\n" +
        "        return kofun_rt_empty_text_list();\n" +
        "    }\n" +
        "    KofunTextListAllocation *allocation = malloc(\n" +
        "        sizeof(KofunTextListAllocation) + length * sizeof(const char *));\n" +
        "    if (allocation == NULL) {\n" +
        "        runtime_error(\"error[R010]: argument List[Text] allocation failed\");\n" +
        "        return kofun_rt_empty_text_list();\n" +
        "    }\n" +
        "    allocation->next = kofun_rt_text_list_allocations;\n" +
        "    kofun_rt_text_list_allocations = allocation;\n" +
        "    for (size_t index = 0; index < length; ++index) {\n" +
        "        allocation->items[index] = kofun_rt_profile_copy_n(\n" +
        "            argv[index + 1], strlen(argv[index + 1]));\n" +
        "        if (failed) return kofun_rt_empty_text_list();\n" +
        "    }\n" +
        "    KofunTextList result = { (int64_t)length, allocation->items };\n" +
        "    return result;\n" +
        "}\n\n" +
        "static int64_t kofun_rt_text_len(const char *value) {\n" +
        "    size_t length = strlen(value);\n" +
        "    if ((uint64_t)length > (uint64_t)INT64_MAX) {\n" +
        "        runtime_error(\"error[R010]: Text length exceeds Int\");\n" +
        "        return 0;\n" +
        "    }\n" +
        "    return (int64_t)length;\n" +
        "}\n\n" +
        "static bool kofun_rt_text_contains(\n" +
        "    const char *value,\n" +
        "    const char *needle\n" +
        ") {\n" +
        "    return strstr(value, needle) != NULL;\n" +
        "}\n\n" +
        "static int64_t kofun_rt_find(const char *value, const char *needle) {\n" +
        "    const char *found = strstr(value, needle);\n" +
        "    return found == NULL ? INT64_C(-1) : (int64_t)(found - value);\n" +
        "}\n\n" +
        "static bool kofun_rt_starts_with(\n" +
        "    const char *value,\n" +
        "    const char *prefix\n" +
        ") {\n" +
        "    size_t prefix_length = strlen(prefix);\n" +
        "    return strncmp(value, prefix, prefix_length) == 0;\n" +
        "}\n\n" +
        "static bool kofun_rt_is_digit(const char *value) {\n" +
        "    return value[0] != '\\0' && value[1] == '\\0' &&\n" +
        "        isdigit((unsigned char)value[0]) != 0;\n" +
        "}\n\n" +
        "static bool kofun_rt_is_space(const char *value) {\n" +
        "    return value[0] != '\\0' && value[1] == '\\0' &&\n" +
        "        isspace((unsigned char)value[0]) != 0;\n" +
        "}\n\n" +
        "static bool kofun_rt_is_xid_continue(const char *value) {\n" +
        "    uint32_t codepoint = 0;\n" +
        "    size_t width = 0;\n" +
        "    size_t length = strlen(value);\n" +
        "    if (!kofun_unicode_decode((const uint8_t *)value, length, 0,\n" +
        "                              &codepoint, &width)) {\n" +
        "        return false;\n" +
        "    }\n" +
        "    return kofun_unicode_is_xid_continue(codepoint);\n" +
        "}\n\n" +
        "static const char *kofun_rt_text_slice(\n" +
        "    const char *value,\n" +
        "    int64_t start,\n" +
        "    int64_t end\n" +
        ") {\n" +
        "    int64_t length = kofun_rt_text_len(value);\n" +
        "    if (failed) return \"\";\n" +
        "    if (start < 0) start = 0;\n" +
        "    if (end < start) end = start;\n" +
        "    if (start > length) start = length;\n" +
        "    if (end > length) end = length;\n" +
        "    return kofun_rt_profile_copy_n(\n" +
        "        value + start, (size_t)(end - start));\n" +
        "}\n\n" +
        "static const char *kofun_rt_trim(const char *value) {\n" +
        "    const unsigned char *start = (const unsigned char *)value;\n" +
        "    while (*start != '\\0' && isspace(*start)) ++start;\n" +
        "    const unsigned char *end =\n" +
        "        (const unsigned char *)value + strlen(value);\n" +
        "    while (end > start && isspace(end[-1])) --end;\n" +
        "    return kofun_rt_profile_copy_n(\n" +
        "        (const char *)start, (size_t)(end - start));\n" +
        "}\n\n" +
        "static const char *kofun_rt_validate_unicode_source(const char *value) {\n" +
        "    KofunUnicodeError unicode_error;\n" +
        "    if (kofun_unicode_validate_source((const uint8_t *)value,\n" +
        "                                      strlen(value), &unicode_error)) {\n" +
        "        return \"\";\n" +
        "    }\n" +
        "    char message[1024];\n" +
        "    kofun_unicode_format_error(&unicode_error,\n" +
        "        getenv(\"KOFUN_DIAGNOSTIC_LOCALE\"), message, sizeof(message));\n" +
        "    return kofun_rt_profile_copy_n(message, strlen(message));\n" +
        "}\n\n" +
        "static const char *kofun_rt_read_text(const char *path) {\n" +
        "    FILE *file = fopen(path, \"rb\");\n" +
        "    if (file == NULL) {\n" +
        "        runtime_error(\"error[R010]: cannot open input file\");\n" +
        "        return \"\";\n" +
        "    }\n" +
        "    if (fseek(file, 0, SEEK_END) != 0) {\n" +
        "        fclose(file);\n" +
        "        runtime_error(\"error[R010]: cannot seek input file\");\n" +
        "        return \"\";\n" +
        "    }\n" +
        "    long measured = ftell(file);\n" +
        "    if (measured < 0) {\n" +
        "        fclose(file);\n" +
        "        runtime_error(\"error[R010]: cannot measure input file\");\n" +
        "        return \"\";\n" +
        "    }\n" +
        "    rewind(file);\n" +
        "    size_t size = (size_t)measured;\n" +
        "    char *result = kofun_rt_profile_text_allocate(size);\n" +
        "    if (result == NULL) {\n" +
        "        fclose(file);\n" +
        "        return \"\";\n" +
        "    }\n" +
        "    size_t read = fread(result, 1, size, file);\n" +
        "    if (read != size && ferror(file)) {\n" +
        "        fclose(file);\n" +
        "        runtime_error(\"error[R010]: cannot read input file\");\n" +
        "        return \"\";\n" +
        "    }\n" +
        "    result[read] = '\\0';\n" +
        "    fclose(file);\n" +
        "    return result;\n" +
        "}\n\n" +
        "static void kofun_rt_write_text(\n" +
        "    const char *path,\n" +
        "    const char *value\n" +
        ") {\n" +
        "    FILE *file = fopen(path, \"wb\");\n" +
        "    if (file == NULL) {\n" +
        "        runtime_error(\"error[R010]: cannot open output file\");\n" +
        "        return;\n" +
        "    }\n" +
        "    size_t length = strlen(value);\n" +
        "    if (fwrite(value, 1, length, file) != length) {\n" +
        "        fclose(file);\n" +
        "        runtime_error(\"error[R010]: cannot write output file\");\n" +
        "        return;\n" +
        "    }\n" +
        "    if (fclose(file) != 0) {\n" +
        "        runtime_error(\"error[R010]: cannot close output file\");\n" +
        "    }\n" +
        "}\n\n"
        profile_main =
        "    (void)kofun_rt_args;\n" +
        "    (void)kofun_rt_text_len;\n" +
        "    (void)kofun_rt_text_contains;\n" +
        "    (void)kofun_rt_find;\n" +
        "    (void)kofun_rt_starts_with;\n" +
        "    (void)kofun_rt_is_digit;\n" +
        "    (void)kofun_rt_is_space;\n" +
        "    (void)kofun_rt_is_xid_continue;\n" +
        "    (void)kofun_rt_text_slice;\n" +
        "    (void)kofun_rt_trim;\n" +
        "    (void)kofun_rt_validate_unicode_source;\n" +
        "    (void)kofun_rt_read_text;\n" +
        "    (void)kofun_rt_write_text;\n"
    }
    let mut program =
    main_signature +
    "    (void)checked_add;\n" +
    "    (void)checked_sub;\n" +
    "    (void)checked_mul;\n" +
    "    (void)checked_neg;\n" +
    "    (void)floor_div;\n" +
    "    (void)floor_mod;\n" +
    text_main +
    text_index_main +
    list_main +
    profile_main +
    statements +
    "    return 0;\n" +
    "}\n"
    if profile {
        let prelude =
        "    (void)checked_add;\n" +
        "    (void)checked_sub;\n" +
        "    (void)checked_mul;\n" +
        "    (void)checked_neg;\n" +
        "    (void)floor_div;\n" +
        "    (void)floor_mod;\n" +
        text_main +
        text_index_main +
        list_main +
        profile_main
        program = emit_profile_program(source, prelude)
    }
    return "/* Generated by the Kofun-written Stage 1 seed compiler. */\n" +
    "#include <inttypes.h>\n" +
    "#include <stdbool.h>\n" +
    "#include <stdint.h>\n" +
    "#include <stdio.h>\n" +
    text_headers +
    profile_headers +
    "\n" +
    "static bool failed;\n\n" +
    "static void runtime_error(const char *message) {\n" +
    "    if (!failed) {\n" +
    "        fputs(message, stderr);\n" +
    "        fputc('\\n', stderr);\n" +
    "    }\n" +
    "    failed = true;\n" +
    "}\n\n" +
    "static int64_t checked_add(int64_t left, int64_t right) {\n" +
    "    int64_t result;\n" +
    "    if (__builtin_add_overflow(left, right, &result)) {\n" +
    "        runtime_error(\"error[R010]: integer overflow in operator `+`\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    return result;\n" +
    "}\n\n" +
    "static int64_t checked_sub(int64_t left, int64_t right) {\n" +
    "    int64_t result;\n" +
    "    if (__builtin_sub_overflow(left, right, &result)) {\n" +
    "        runtime_error(\"error[R010]: integer overflow in operator `-`\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    return result;\n" +
    "}\n\n" +
    "static int64_t checked_mul(int64_t left, int64_t right) {\n" +
    "    int64_t result;\n" +
    "    if (__builtin_mul_overflow(left, right, &result)) {\n" +
    "        runtime_error(\"error[R010]: integer overflow in operator `*`\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    return result;\n" +
    "}\n\n" +
    "static int64_t checked_neg(int64_t value) {\n" +
    "    if (value == INT64_MIN) {\n" +
    "        runtime_error(\"error[R010]: integer overflow in unary operator `-`\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    return -value;\n" +
    "}\n\n" +
    "static int64_t floor_div(int64_t left, int64_t right) {\n" +
    "    if (right == 0) {\n" +
    "        runtime_error(\"error[R010]: operator `//` failed: division by zero\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    if (left == INT64_MIN && right == -1) {\n" +
    "        runtime_error(\"error[R010]: integer overflow in operator `//`\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    int64_t quotient = left / right;\n" +
    "    int64_t remainder = left % right;\n" +
    "    if (remainder != 0 && ((remainder < 0) != (right < 0))) --quotient;\n" +
    "    return quotient;\n" +
    "}\n\n" +
    "static int64_t floor_mod(int64_t left, int64_t right) {\n" +
    "    if (right == 0) {\n" +
    "        runtime_error(\"error[R010]: operator `%` failed: division by zero\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    if (left == INT64_MIN && right == -1) return 0;\n" +
    "    int64_t remainder = left % right;\n" +
    "    if (remainder != 0 && ((remainder < 0) != (right < 0))) remainder += right;\n" +
    "    return remainder;\n" +
    "}\n\n" +
    text_runtime +
    text_index_runtime +
    list_runtime +
    profile_runtime +
    fail_runtime +
    program
}

fn compile_file(input_path: Text, output_path: Text) -> Bool {
    let input = read_text(input_path)
    let unicode_error = validate_unicode_source(input)
    if len(unicode_error) > 0 {
        print(unicode_error)
        return false
    }
    let source = input + "\n"
    if valid_source(source) {
        write_text(output_path, emit_c(source, false))
        print(output_path)
        return true
    }
    let profile_source = logical_source(source)
    if !valid_profile_source(profile_source) {
        print("compile error: unsupported Kofun integer Core source")
        return false
    }
    write_text(output_path, emit_c(profile_source, true))
    print(output_path)
    return true
}

fn main() {
    let arguments = args()
    if len(arguments) != 2 {
        print("usage: kofun-stage1 INPUT.kofun OUTPUT.c")
        return
    }
    if !compile_file(arguments[0], arguments[1]) {
        fail()
    }
}
