# Kofun Stage 1 compiler seed.
#
# The compiler accepts a deliberately small integer Core: `let` bindings and
# `print(EXPR)` statements inside `fn main()`. Every expression is tokenized,
# parsed and resolved here, then lowered to a C11 expression tree over checked
# Int64 helpers. The emitted program carries no parser, no symbol table and no
# fragment of the user's source: names are resolved to C locals at compile time
# and literals are range-checked at compile time. This source is canonical;
# compiler.c is the audited bootstrap artifact generated from it.

fn identifier_char(char: Text) -> Bool {
    return is_xid_continue(char) ||
    contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", char)
}

fn valid_name(name: Text) -> Bool {
    let symbols = chars(name)
    if len(symbols) == 0 || is_digit(symbols[0]) {
        return false
    }
    for index in 0 .. len(symbols) {
        if !identifier_char(symbols[index]) {
            return false
        }
    }
    return true
}

fn digit_value(symbol: Text) -> Int {
    return find("0123456789", symbol)
}

fn all_digits(value: Text) -> Bool {
    let symbols = chars(value)
    if len(symbols) == 0 {
        return false
    }
    for index in 0 .. len(symbols) {
        if !is_digit(symbols[index]) {
            return false
        }
    }
    return true
}

# Digit-string comparison. Text ordering is outside the Core, so magnitudes are
# compared by significant length and then digit by digit.
fn within_bound(digits: Text, bound: Text) -> Bool {
    let symbols = chars(digits)
    let limit = chars(bound)
    let mut start = 0
    while start + 1 < len(symbols) && symbols[start] == "0" {
        start = start + 1
    }
    let significant = len(symbols) - start
    if significant != len(limit) {
        return significant < len(limit)
    }
    for index in 0 .. len(limit) {
        let left = digit_value(symbols[start + index])
        let right = digit_value(limit[index])
        if left != right {
            return left < right
        }
    }
    return true
}

# An operator is infix only when a complete operand precedes it; otherwise it is
# a prefix sign. This is what separates `-7 // 2` from `7 - 2`.
fn preceded_by_operand(expression: Text, index: Int) -> Bool {
    let symbols = chars(expression)
    let mut cursor = index - 1
    while cursor >= 0 {
        let symbol = symbols[cursor]
        if !is_space(symbol) {
            return symbol == ")" || identifier_char(symbol)
        }
        cursor = cursor - 1
    }
    return false
}

# Index of the last top-level infix operator drawn from `operators`, or -1.
# Splitting at the *last* one makes every operator left-associative. The second
# `/` of `//` is never preceded by an operand, so `//` reports its first byte.
fn split_binary(expression: Text, operators: Text) -> Int {
    let symbols = chars(expression)
    let mut depth = 0
    let mut found = -1
    for index in 0 .. len(symbols) {
        let symbol = symbols[index]
        if symbol == "(" {
            depth = depth + 1
        } else if symbol == ")" {
            depth = depth - 1
        } else if depth == 0 && contains(operators, symbol) {
            if preceded_by_operand(expression, index) {
                found = index
            }
        }
    }
    return found
}

fn wraps_whole(expression: Text) -> Bool {
    let symbols = chars(expression)
    if len(symbols) < 2 || !(symbols[0] == "(") {
        return false
    }
    let mut depth = 0
    for index in 0 .. len(symbols) {
        let symbol = symbols[index]
        if symbol == "(" {
            depth = depth + 1
        } else if symbol == ")" {
            depth = depth - 1
            if depth == 0 {
                return index == len(symbols) - 1
            }
        }
    }
    return false
}

# A lowered expression is `STATEMENTS + OPERAND`: zero or more complete C
# statements, each ending in a newline, followed by a newline-free operand that
# names the result. Emitting one statement per operator is what makes the
# evaluation order of the Core observable and fixed: C leaves the order of
# function arguments unspecified, so a nested call tree would let the host C
# compiler decide which of two failing operators reports first.
fn last_newline(value: Text) -> Int {
    let symbols = chars(value)
    let mut found = -1
    for index in 0 .. len(symbols) {
        if symbols[index] == "\n" {
            found = index
        }
    }
    return found
}

fn lowered_statements(lowered: Text) -> Text {
    let cut = last_newline(lowered)
    if cut < 0 {
        return ""
    }
    return text_slice(lowered, 0, cut + 1)
}

fn lowered_operand(lowered: Text) -> Text {
    let cut = last_newline(lowered)
    return text_slice(lowered, cut + 1, len(lowered))
}

# Each operator node owns a temporary named after its path from the root of the
# expression, so names are unique without a mutable counter.
fn lower_step(path: Text, callee: Text, left: Text, right: Text) -> Text {
    let temporary = "kt_" + path
    return lowered_statements(left) + lowered_statements(right) +
    "        int64_t " + temporary + " = " + callee +
    lowered_operand(left) + ", " + lowered_operand(right) + ");\n" +
    temporary
}

fn lower_atom(atom: Text, bound: Text) -> Text {
    if all_digits(atom) {
        if !within_bound(atom, "9223372036854775807") {
            return ""
        }
        return atom
    }
    if !valid_name(atom) {
        return ""
    }
    if find(bound, "|" + atom + "|") < 0 {
        return ""
    }
    return "kf_" + atom
}

# A negated decimal literal is folded at compile time so that the one magnitude
# with no positive counterpart still has a C spelling.
fn lower_negation(operand: Text, bound: Text, path: Text) -> Text {
    let trimmed = trim(operand)
    if all_digits(trimmed) {
        if within_bound(trimmed, "9223372036854775807") {
            return "-" + trimmed
        }
        if within_bound(trimmed, "9223372036854775808") {
            return "INT64_MIN"
        }
        return ""
    }
    let inner = lower_expression(trimmed, bound, path + "u")
    if len(inner) == 0 {
        return ""
    }
    let temporary = "kt_" + path
    return lowered_statements(inner) +
    "        int64_t " + temporary + " = checked_neg(" +
    lowered_operand(inner) + ");\n" +
    temporary
}

# Lowers one Core expression to a C11 expression, or "" when it is not Core.
# Acceptance is exactly "this returns a non-empty string", so the parser is the
# only definition of what the Core admits.
fn lower_expression(expression: Text, bound: Text, path: Text) -> Text {
    let trimmed = trim(expression)
    if len(trimmed) == 0 {
        return ""
    }

    let additive = split_binary(trimmed, "+-")
    if additive >= 0 {
        let left = lower_expression(
            text_slice(trimmed, 0, additive), bound, path + "l")
        let right = lower_expression(
            text_slice(trimmed, additive + 1, len(trimmed)), bound, path + "r")
        if len(left) == 0 || len(right) == 0 {
            return ""
        }
        if text_slice(trimmed, additive, additive + 1) == "+" {
            return lower_step(path, "checked_add(", left, right)
        }
        return lower_step(path, "checked_sub(", left, right)
    }

    let multiplicative = split_binary(trimmed, "*%/")
    if multiplicative >= 0 {
        let operator = text_slice(trimmed, multiplicative, multiplicative + 1)
        let mut callee = "checked_mul("
        let mut skip = 1
        if operator == "%" {
            callee = "floor_mod("
        } else if operator == "/" {
            # `/` is not defined on Int; only the floor operator `//` is Core.
            if multiplicative + 2 > len(trimmed) {
                return ""
            }
            if !(text_slice(trimmed, multiplicative + 1,
                            multiplicative + 2) == "/") {
                return ""
            }
            callee = "floor_div("
            skip = 2
        }
        let left = lower_expression(
            text_slice(trimmed, 0, multiplicative), bound, path + "l")
        let right = lower_expression(
            text_slice(trimmed, multiplicative + skip, len(trimmed)),
            bound, path + "r")
        if len(left) == 0 || len(right) == 0 {
            return ""
        }
        return lower_step(path, callee, left, right)
    }

    if starts_with(trimmed, "+") {
        return lower_expression(
            text_slice(trimmed, 1, len(trimmed)), bound, path)
    }
    if starts_with(trimmed, "-") {
        return lower_negation(text_slice(trimmed, 1, len(trimmed)), bound, path)
    }
    if wraps_whole(trimmed) {
        return lower_expression(
            text_slice(trimmed, 1, len(trimmed) - 1), bound, path)
    }
    return lower_atom(trimmed, bound)
}

fn print_expression(line: Text) -> Text {
    let marker = "print("
    let start = find(line, marker)
    if start < 0 {
        return ""
    }

    let expression_start = start + len(marker)
    let symbols = chars(line)
    let mut depth = 1
    let mut index = expression_start
    while index < len(symbols) {
        let symbol = symbols[index]
        if symbol == "(" {
            depth = depth + 1
        } else if symbol == ")" {
            depth = depth - 1
            if depth == 0 {
                return trim(text_slice(line, expression_start, index))
            }
        }
        index = index + 1
    }
    return ""
}

fn binding_name(line: Text) -> Text {
    let equals = find(line, "=")
    if equals < 0 {
        return ""
    }
    let name = trim(text_slice(line, 4, equals))
    let colon = find(name, ":")
    if colon >= 0 {
        return trim(text_slice(name, 0, colon))
    }
    return name
}

fn binding_expression(line: Text) -> Text {
    let equals = find(line, "=")
    if equals < 0 {
        return ""
    }
    return trim(text_slice(line, equals + 1, len(line)))
}

fn valid_source(source: Text) -> Bool {
    let symbols = chars(source)
    let mut line_start = 0
    let mut prints = 0
    let mut main_headers = 0
    let mut body_depth = 0
    let mut bound = "|"
    for index in 0 .. len(symbols) {
        if symbols[index] == "\n" {
            let line = trim(text_slice(source, line_start, index))
            if len(line) == 0 || starts_with(line, "#") {
                # Comments and blank lines do not change the structural state.
            } else if line == "fn main() {" {
                if main_headers != 0 || body_depth != 0 {
                    return false
                }
                main_headers = main_headers + 1
                body_depth = 1
            } else if line == "}" {
                if body_depth != 1 {
                    return false
                }
                body_depth = 0
            } else if starts_with(line, "let ") {
                if body_depth != 1 {
                    return false
                }
                let name = binding_name(line)
                if !valid_name(name) {
                    return false
                }
                # One binding per name: the language rejects same-scope
                # shadowing, so the seed rejects it too.
                if find(bound, "|" + name + "|") >= 0 {
                    return false
                }
                if len(lower_expression(binding_expression(line), bound,
                                       "x")) == 0 {
                    return false
                }
                bound = bound + name + "|"
            } else if starts_with(line, "print(") {
                if body_depth != 1 {
                    return false
                }
                let expression = print_expression(line)
                if len(lower_expression(expression, bound, "x")) == 0 {
                    return false
                }
                prints = prints + 1
            } else {
                return false
            }
            line_start = index + 1
        }
    }
    return main_headers == 1 && body_depth == 0 && prints > 0
}

fn emit_statements(source: Text) -> Text {
    let symbols = chars(source)
    let mut line_start = 0
    let mut emitted = ""
    let mut bound = "|"
    for index in 0 .. len(symbols) {
        if symbols[index] == "\n" {
            let line = trim(text_slice(source, line_start, index))
            if starts_with(line, "let ") {
                let name = binding_name(line)
                let value = lower_expression(binding_expression(line), bound,
                                             "x")
                emitted = emitted +
                "    int64_t kf_" + name + ";\n" +
                "    {\n" +
                lowered_statements(value) +
                "        kf_" + name + " = " + lowered_operand(value) + ";\n" +
                "    }\n" +
                "    if (failed) return 1;\n" +
                "    (void)kf_" + name + ";\n"
                bound = bound + name + "|"
            } else if starts_with(line, "print(") {
                let value = lower_expression(print_expression(line), bound, "x")
                emitted = emitted +
                "    {\n" +
                lowered_statements(value) +
                "        int64_t value = " + lowered_operand(value) + ";\n" +
                "        if (failed) return 1;\n" +
                "        printf(\"%\" PRId64 \"\\n\", value);\n" +
                "    }\n"
            }
            line_start = index + 1
        }
    }
    return emitted
}

fn emit_c(source: Text) -> Text {
    return "/* Generated by the Kofun-written Stage 1 seed compiler. */\n" +
    "#include <inttypes.h>\n" +
    "#include <stdbool.h>\n" +
    "#include <stdint.h>\n" +
    "#include <stdio.h>\n\n" +
    "static bool failed;\n\n" +
    "static void runtime_error(const char *message) {\n" +
    "    if (!failed) {\n" +
    "        fputs(message, stderr);\n" +
    "        fputc('\\n', stderr);\n" +
    "    }\n" +
    "    failed = true;\n" +
    "}\n\n" +
    "static int64_t checked_add(int64_t left, int64_t right) {\n" +
    "    int64_t result;\n" +
    "    if (__builtin_add_overflow(left, right, &result)) {\n" +
    "        runtime_error(\"error[R010]: integer overflow in operator `+`\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    return result;\n" +
    "}\n\n" +
    "static int64_t checked_sub(int64_t left, int64_t right) {\n" +
    "    int64_t result;\n" +
    "    if (__builtin_sub_overflow(left, right, &result)) {\n" +
    "        runtime_error(\"error[R010]: integer overflow in operator `-`\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    return result;\n" +
    "}\n\n" +
    "static int64_t checked_mul(int64_t left, int64_t right) {\n" +
    "    int64_t result;\n" +
    "    if (__builtin_mul_overflow(left, right, &result)) {\n" +
    "        runtime_error(\"error[R010]: integer overflow in operator `*`\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    return result;\n" +
    "}\n\n" +
    "static int64_t checked_neg(int64_t value) {\n" +
    "    if (value == INT64_MIN) {\n" +
    "        runtime_error(\"error[R010]: integer overflow in unary operator `-`\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    return -value;\n" +
    "}\n\n" +
    "static int64_t floor_div(int64_t left, int64_t right) {\n" +
    "    if (right == 0) {\n" +
    "        runtime_error(\"error[R010]: operator `//` failed: division by zero\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    if (left == INT64_MIN && right == -1) {\n" +
    "        runtime_error(\"error[R010]: integer overflow in operator `//`\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    int64_t quotient = left / right;\n" +
    "    int64_t remainder = left % right;\n" +
    "    if (remainder != 0 && ((remainder < 0) != (right < 0))) --quotient;\n" +
    "    return quotient;\n" +
    "}\n\n" +
    "static int64_t floor_mod(int64_t left, int64_t right) {\n" +
    "    if (right == 0) {\n" +
    "        runtime_error(\"error[R010]: operator `%` failed: division by zero\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    if (left == INT64_MIN && right == -1) return 0;\n" +
    "    int64_t remainder = left % right;\n" +
    "    if (remainder != 0 && ((remainder < 0) != (right < 0))) remainder += right;\n" +
    "    return remainder;\n" +
    "}\n\n" +
    "int main(void) {\n" +
    "    (void)checked_add;\n" +
    "    (void)checked_sub;\n" +
    "    (void)checked_mul;\n" +
    "    (void)checked_neg;\n" +
    "    (void)floor_div;\n" +
    "    (void)floor_mod;\n" +
    emit_statements(source) +
    "    return 0;\n" +
    "}\n"
}

fn compile_file(input_path: Text, output_path: Text) -> Bool {
    let input = read_text(input_path)
    let unicode_error = validate_unicode_source(input)
    if len(unicode_error) > 0 {
        print(unicode_error)
        return false
    }
    let source = input + "\n"
    if !valid_source(source) {
        print("compile error: unsupported Kofun integer Core source")
        return false
    }
    write_text(output_path, emit_c(source))
    print(output_path)
    return true
}

fn main() {
    let arguments = args()
    if len(arguments) != 2 {
        print("usage: kofun-stage1 INPUT.kofun OUTPUT.c")
        return
    }
    compile_file(arguments[0], arguments[1])
}
