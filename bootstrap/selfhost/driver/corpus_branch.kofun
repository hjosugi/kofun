fn main() {
    let n = 7
    if n > 5 {
        let doubled = n * 2
        print(doubled)
    }
    if n > 100 {
        print(0)
    } else {
        let doubled = n + 1
        print(doubled)
    }
    if n == 1 {
        print(1)
    } else if n == 7 {
        print(7)
    } else if 1 // 0 == 0 {
        print(2)
    } else {
        print(3)
    }
    if n > 0 {
        if n > 6 {
            let inner = n * 3
            print(inner)
        } else {
            print(4)
        }
    } else {
        print(5)
    }
    let outer: Bool = n > 0 && n < 10
    if !outer {
        print(6)
    } else if outer || 1 // 0 == 0 {
        print(8)
    }
    print(n)
}
