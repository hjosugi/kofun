# Exercise every immediate-encoding boundary used by the two native targets.
# INT64_MIN is written the way the numeric corpus writes it because an atom
# must fit before unary minus applies.

fn identity(n: Int) -> Int {
    return n
}

fn quotient(a: Int, b: Int) -> Int {
    return a // b
}

fn remainder(a: Int, b: Int) -> Int {
    return a % b
}

fn main() {
    let maximum = 9223372036854775807
    let minimum = -9223372036854775807 - 1
    print(maximum)
    print(minimum)
    print(maximum - 1)
    print(minimum + 1)
    print(remainder(minimum, -1))
    print(quotient(minimum, 1))
    print(identity(65535))
    print(identity(65536))
    print(identity(2147483647))
    print(identity(2147483648))
    print(identity(4294967295))
    print(identity(4294967296))
    print(identity(-2147483648))
    print(identity(-2147483649))
    print(identity(-4294967296))
}
