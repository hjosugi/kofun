# `/` on Int truncates toward zero, matching the compiler built from the frozen
# self-host source, the Stage 1 seed, and the wasm32 backend. The C11 Stage 1
# emitter does not accept `/` at all, so this is a native-only fixture rather
# than a cross-backend conformance case.

fn truncated(a: Int, b: Int) -> Int {
    return a / b
}

fn main() {
    print(truncated(7, 2))
    print(truncated(-7, 2))
    print(truncated(7, -2))
    print(truncated(-7, -2))
    print(truncated(40, 8))
    print(truncated(9, -1))
}
