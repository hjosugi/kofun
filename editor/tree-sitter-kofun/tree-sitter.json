{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "kofun",
      "camelcase": "Kofun",
      "title": "Kofun",
      "scope": "source.kofun",
      "file-types": [
        "kofun"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ],
      "injection-regex": "^kofun$",
      "class-name": "TreeSitterKofun"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT OR Apache-2.0",
    "description": "Tree-sitter grammar for the Kofun programming language",
    "authors": [
      {
        "name": "Kofun contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/hjosugi/kofun"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}