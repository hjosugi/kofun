import framework.http

repr(C) struct Result {
  status: CInt,
}

extern "C" fn status_code(result: Result) -> CInt

fn classify(read value: Int) -> Text {
  let mut current = value
  return if current > 0 {
    "positive"
  } else {
    "other"
  }
}

fn main() {
  let values = [1, 2, 3]
  let combine = (left, right) => left + right
  let annotated = (item: Int) => item
  let answer = values
  |> map(fn(item: Int) => item * 2)
  |> map(item => item)
  |> sum()
  print(answer)
}
