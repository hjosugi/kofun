# Recognized shape 3: `x == null` refines the *false* edge, so the narrowed
# use lives in the `else`. The taken branch never reads a payload.

fn observed(x: Int?) -> Int {
    let mut seen: Int = 0
    if x == null {
        seen = -1
    } else {
        seen = x + 1
    }
    return seen
}

fn main() -> Int {
    let present: Int? = 41
    let absent: Int? = null
    print(observed(present))
    print(observed(absent))
    return 0
}
