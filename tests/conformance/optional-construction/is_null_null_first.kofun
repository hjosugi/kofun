# Recognized shape 4: `null == x` refines the false edge, in the other operand
# order.

fn observed(x: Int?) -> Int {
    let mut seen: Int = 0
    if null == x {
        seen = -1
    } else {
        seen = x + 1
    }
    return seen
}

fn main() -> Int {
    let present: Int? = 41
    let absent: Int? = null
    print(observed(present))
    print(observed(absent))
    return 0
}
