# Recognized shape 1: `x != null` refines the true edge, and only the true
# edge. The false path prints a value that never read a payload.

fn observed(x: Int?) -> Int {
    if x != null {
        return x + 1
    }
    return -1
}

fn main() -> Int {
    let present: Int? = 41
    let absent: Int? = null
    print(observed(present))
    print(observed(absent))
    return 0
}
