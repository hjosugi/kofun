pub type LiveChoice =
    | Empty
    | Count(value: Int)

pub fn scan(read values: List[Text]) -> Int {
    for value in values {
        print(value)
    }
    return 0
}

pub fn answer() -> Int {
    return 42
}

internal fn double(value: Int) -> Int {
    return value + value
}

private fn hidden(value: Int) -> Int {
    return value
}
