fn observe(marker: Int, value: Int) -> Int {
    print(marker)
    return value
}

fn combine(as_first left: Int, as_second right: Int) -> Int {
    return left * 10 + right
}

fn main() -> Int {
    print(combine(
        as_second: observe(2, 2),
        as_first: observe(1, 1)
    ))
    return 0
}
