fn main() {
    if 0.1 + 0.2 == 0.3 {
        print(1)
    } else {
        print(0)
    }
    if 9007199254740993.0 + 1.0 == 9007199254740994.0 {
        print(1)
    } else {
        print(0)
    }
    if 1.1 * 1.1 == 1.21 {
        print(1)
    } else {
        print(0)
    }
    if 5.5 - 2.25 == 3.25 {
        print(1)
    } else {
        print(0)
    }
}
