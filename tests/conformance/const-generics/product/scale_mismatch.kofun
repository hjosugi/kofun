# The erasure sentinel.
#
# Under an annotation reader that returns only the head token, `Fixed[3]` and
# `Fixed[2]` are both `Fixed`, this source compiles, and the capability is
# silently broken while every gate stays green. It must be refused.
type Fixed[const scale: Int] = {
    significand: Int,
}

fn cents(value: Fixed[2]) -> Fixed[2] {
    return value
}

fn mills(value: Fixed[3]) -> Fixed[2] {
    return value
}

fn main() {
    print(0)
}
