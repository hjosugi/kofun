# An ordinary type parameter on a nominal type needs field substitution and
# per-instantiation layout. #916 builds neither, so the product path refuses
# this by name instead of accepting a surface it cannot lower. The bounded
# frontend still models it, which is what gives the kind-mismatch diagnostics
# something to be a mismatch against.
type Boxed[T] = {
    value: T,
}

fn unbox(box: Boxed[Int]) -> Boxed[Int] {
    return box
}

fn main() {
    print(0)
}
