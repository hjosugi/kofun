# The production ownership-mode parameter path retired by #881. The internal
# name `token`, not the `read` mode, is the lexical body binding.
type Token = {
    start: Int,
}

fn peek(read token: Token) -> Int {
    return token.start
}

fn main() -> Int {
    let token: Token = Token(start: 7)
    print(peek(token))
    return 0
}
