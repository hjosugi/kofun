# Records must not collide with blocks, control-flow conditions, loop
# iterables, list literals, or flat constructor uses. Construction is always
# the parenthesized labelled call form, so every `{` below opens a block.

type Flag =
    | On
    | Off

type Point = {
    x: Int,
    y: Int,
}

fn choose(flag: Flag) -> Int {
    # `flag { ... }` is never construction: the `{` opens the `if` block.
    if flag == On {
        return 1
    }
    return 0
}

fn sum(read points: List[Point]) -> Int {
    let mut total = 0
    for point in points {
        total = total + point.x + point.y
    }
    return total
}

fn scaled(read point: Point) -> Point {
    return Point(x: point.x * 2, y: point.y * 2)
}

fn counted() -> Int {
    let mut index = 0
    while index < 3 {
        index = index + 1
    }
    return index
}

fn pair() -> List[Point] {
    return [Point(x: 1, y: 2), scaled(Point(x: 3, y: 4))]
}

fn total() -> Int {
    return sum(pair())
}

fn flagged() -> Int {
    return choose(On)
}
