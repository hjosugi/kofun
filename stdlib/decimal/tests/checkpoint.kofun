# Native Decimal slice-5 checkpoint. Every observation executes the compiler
# runtime; no Int significand projection remains.

fn main() {
    let mut checked = 0
    if 0.1 + 0.2 == 0.3 { checked = checked + 1 }
    if Decimal.round(2.5, 0, HalfUp) == 3.0 { checked = checked + 1 }
    if Decimal.round(-2.5, 0, HalfUp) == -3.0 { checked = checked + 1 }
    if Decimal.round(2.5, 0, HalfEven) == 2.0 { checked = checked + 1 }
    if Decimal.round(-2.5, 0, HalfEven) == -2.0 { checked = checked + 1 }
    if Decimal.round(2.5, 0, TowardZero) == 2.0 { checked = checked + 1 }
    if Decimal.round(-2.5, 0, TowardZero) == -2.0 { checked = checked + 1 }
    if Decimal.round(2.5, 0, Floor) == 2.0 { checked = checked + 1 }
    if Decimal.round(-2.5, 0, Floor) == -3.0 { checked = checked + 1 }
    if Decimal.round(2.5, 0, Ceiling) == 3.0 { checked = checked + 1 }
    if Decimal.round(-2.5, 0, Ceiling) == -2.0 { checked = checked + 1 }
    if Decimal.round(1.999, 2, HalfUp) == 2.0 { checked = checked + 1 }
    if Decimal.divide(1.0, 8.0, 2, HalfUp) == 0.13 { checked = checked + 1 }
    if Decimal.divide(1.0, 8.0, 2, HalfEven) == 0.12 { checked = checked + 1 }
    if Decimal.parse(Decimal.format(1.2, 2)) == 1.2 {
        checked = checked + 1
    }
    print(checked)
    print(Decimal.format(Decimal.parse("-1.20"), 2))
}
