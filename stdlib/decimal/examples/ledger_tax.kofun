# Three native Decimal amounts and exact rate 0.0825. Each tax line crosses an
# explicit scale-2 HalfUp boundary before being added to the ledger.

fn main() {
    let amount1 = 19.99
    let amount2 = 5.75
    let amount3 = 123.40
    let rate = 0.0825
    let tax1 = Decimal.round(amount1 * rate, 2, HalfUp)
    let tax2 = Decimal.round(amount2 * rate, 2, HalfUp)
    let tax3 = Decimal.round(amount3 * rate, 2, HalfUp)
    let subtotal = amount1 + amount2 + amount3
    let tax = tax1 + tax2 + tax3
    let total = subtotal + tax
    print(Decimal.format(subtotal, 2))
    print(Decimal.format(tax1, 2))
    print(Decimal.format(tax2, 2))
    print(Decimal.format(tax3, 2))
    print(Decimal.format(tax, 2))
    print(Decimal.format(total, 2))
}
