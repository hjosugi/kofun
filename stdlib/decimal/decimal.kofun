# Compiler-native Decimal checkpoint (slice 5, issue #724).
#
# Decimal is a language type backed by bootstrap/stage2/decimal_v1.c. This
# module deliberately does not redeclare Decimal as an Int significand/scale
# record. The bounded Stage 2 surface is positional because named arguments
# are outside this compiler profile:
#
#   Decimal.round(value, destination_scale, mode)
#   Decimal.divide(left, right, destination_scale, mode)
#   Decimal.format(value, display_scale)
#   Decimal.parse(text)
#
# HalfUp, HalfEven, TowardZero, Floor, and Ceiling are compiler-known mode
# names. There is no overload with a default destination scale or mode.

# `runtime-scale/v1` remains weaker than a future Fixed[scale]. Destination
# scales are ordinary runtime arguments and therefore imply no static scale
# safety. Slice 5 does not publish a placeholder Fixed value: the native
# Decimal and the retired Int64 significand must not coexist under one name.

fn decimal_native_checkpoint() -> Int {
    let sum = 0.1 + 0.2
    if sum != 0.3 {
        return 0
    }
    let rounded = Decimal.round(1.999, 2, HalfUp)
    if rounded != 2.0 {
        return 0
    }
    let quotient = Decimal.divide(1.0, 8.0, 2, HalfEven)
    if quotient != 0.12 {
        return 0
    }
    let parsed = Decimal.parse("-1.20")
    if parsed != -1.2 {
        return 0
    }
    return 1
}

fn main() {
    print(decimal_native_checkpoint())
    print(Decimal.format(Decimal.parse("2.00"), 2))
}
