# Bounded executable producer for the portable date/time contract.  This is
# intentionally the Stage 2 Core subset: nominal Int records, a closed
# one-payload outcome, checked arithmetic, and a strict RFC 3339 parser that
# accepts `Z` and fixed `+HH:MM` / `-HH:MM` offsets.  Host time, host calendar
# routines, and host parsing are never used.

type Duration = {
    seconds: Int,
    nanoseconds: Int,
}

type Instant = {
    seconds: Int,
    nanoseconds: Int,
}

type Date = {
    year: Int,
    month: Int,
    day: Int,
}

type TimeOfDay = {
    hour: Int,
    minute: Int,
    second: Int,
    nanosecond: Int,
}

type LocalDateTime = {
    year: Int,
    month: Int,
    day: Int,
    hour: Int,
    minute: Int,
    second: Int,
    nanosecond: Int,
}

type UtcOffset = {
    seconds: Int,
}

type OffsetDateTime = {
    year: Int,
    month: Int,
    day: Int,
    hour: Int,
    minute: Int,
    second: Int,
    nanosecond: Int,
    offset_seconds: Int,
}

type DateTimeOutcome =
    | DateTimeOk(value: Int)
    | InvalidField(field: Int)
    | ParsePosition(position: Int)
    | InexactConversion(remainder: Int)
    | ArithmeticOverflow(operation: Int)

fn make_duration(seconds: Int, nanoseconds: Int) -> Duration {
    let value: Duration = Duration(
        seconds: seconds,
        nanoseconds: nanoseconds    )
    return value
}

fn make_instant(seconds: Int, nanoseconds: Int) -> Instant {
    let value: Instant = Instant(
        seconds: seconds,
        nanoseconds: nanoseconds    )
    return value
}

fn make_date(year: Int, month: Int, day: Int) -> Date {
    let value: Date = Date(year: year, month: month, day: day)
    return value
}

fn make_time(
    hour: Int,
    minute: Int,
    second: Int,
    nanosecond: Int
) -> TimeOfDay {
    let value: TimeOfDay = TimeOfDay(
        hour: hour,
        minute: minute,
        second: second,
        nanosecond: nanosecond    )
    return value
}

fn make_local_date_time(
    year: Int,
    month: Int,
    day: Int,
    hour: Int,
    minute: Int,
    second: Int,
    nanosecond: Int
) -> LocalDateTime {
    let value: LocalDateTime = LocalDateTime(
        year: year,
        month: month,
        day: day,
        hour: hour,
        minute: minute,
        second: second,
        nanosecond: nanosecond    )
    return value
}

fn make_utc_offset(seconds: Int) -> UtcOffset {
    let value: UtcOffset = UtcOffset(seconds: seconds)
    return value
}

fn make_offset_date_time(
    year: Int,
    month: Int,
    day: Int,
    hour: Int,
    minute: Int,
    second: Int,
    nanosecond: Int,
    offset_seconds: Int
) -> OffsetDateTime {
    let value: OffsetDateTime = OffsetDateTime(
        year: year,
        month: month,
        day: day,
        hour: hour,
        minute: minute,
        second: second,
        nanosecond: nanosecond,
        offset_seconds: offset_seconds    )
    return value
}

fn same_duration(left: Duration, right: Duration) -> Int {
    if left.seconds == right.seconds {
        if left.nanoseconds == right.nanoseconds {
            return 1
        }
    }
    return 0
}

fn same_instant(left: Instant, right: Instant) -> Int {
    if left.seconds == right.seconds {
        if left.nanoseconds == right.nanoseconds {
            return 1
        }
    }
    return 0
}

fn same_date(left: Date, right: Date) -> Int {
    if left.year == right.year {
        if left.month == right.month {
            if left.day == right.day {
                return 1
            }
        }
    }
    return 0
}

fn same_time(left: TimeOfDay, right: TimeOfDay) -> Int {
    if left.hour == right.hour {
        if left.minute == right.minute {
            if left.second == right.second {
                if left.nanosecond == right.nanosecond {
                    return 1
                }
            }
        }
    }
    return 0
}

fn same_local_date_time(
    left: LocalDateTime,
    right: LocalDateTime
) -> Int {
    if left.year == right.year {
        if left.month == right.month {
            if left.day == right.day {
                if left.hour == right.hour {
                    if left.minute == right.minute {
                        if left.second == right.second {
                            if left.nanosecond == right.nanosecond {
                                return 1
                            }
                        }
                    }
                }
            }
        }
    }
    return 0
}

fn same_utc_offset(left: UtcOffset, right: UtcOffset) -> Int {
    if left.seconds == right.seconds {
        return 1
    }
    return 0
}

fn same_offset_date_time(
    left: OffsetDateTime,
    right: OffsetDateTime
) -> Int {
    if left.year == right.year {
        if left.month == right.month {
            if left.day == right.day {
                if left.hour == right.hour {
                    if left.minute == right.minute {
                        if left.second == right.second {
                            if left.nanosecond == right.nanosecond {
                                if left.offset_seconds == right.offset_seconds {
                                    return 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return 0
}

fn normalize_duration(seconds: Int, nanoseconds: Int) -> Duration {
    if nanoseconds < 0 {
        return make_duration(seconds - 1, nanoseconds + 1000000000)
    }
    if nanoseconds >= 1000000000 {
        return make_duration(seconds + 1, nanoseconds - 1000000000)
    }
    return make_duration(seconds, nanoseconds)
}

# The payload is an operation id.  `1` is addition.  The boundary checks run
# before the arithmetic expression, so overflow becomes a closed value rather
# than the backend's R010 runtime failure.
fn checked_add(left: Int, right: Int) -> DateTimeOutcome {
    let maximum = 9223372036854775807
    let minimum = (0 - 9223372036854775807) - 1
    if right > 0 {
        if left > maximum - right {
            return ArithmeticOverflow(1)
        }
    }
    if right < 0 {
        if left < minimum - right {
            return ArithmeticOverflow(1)
        }
    }
    return DateTimeOk(left + right)
}

fn nanos_to_millis(nanoseconds: Int) -> DateTimeOutcome {
    let remainder = nanoseconds % 1000000
    if remainder != 0 {
        return InexactConversion(remainder)
    }
    return DateTimeOk(nanoseconds // 1000000)
}

# Every byte read in this file funnels through `digit_at` or `require_character`
# so the end-of-input check happens exactly once per read.  The measured reason:
# the backend lowers `text_slice` to `kofun_text_slice`, which aborts the process
# with `error[R020]: bounded Text slice out of range` when `end` passes the
# input.  The gate compares an empty stderr golden, so an unguarded read past the
# end is a gate failure, not a typed rejection.
fn digit_at(text: Text, position: Int, length: Int) -> DateTimeOutcome {
    if position >= length { return ParsePosition(position) }
    let symbol = text_slice(text, position, position + 1)
    if symbol == "0" { return DateTimeOk(0) }
    if symbol == "1" { return DateTimeOk(1) }
    if symbol == "2" { return DateTimeOk(2) }
    if symbol == "3" { return DateTimeOk(3) }
    if symbol == "4" { return DateTimeOk(4) }
    if symbol == "5" { return DateTimeOk(5) }
    if symbol == "6" { return DateTimeOk(6) }
    if symbol == "7" { return DateTimeOk(7) }
    if symbol == "8" { return DateTimeOk(8) }
    if symbol == "9" { return DateTimeOk(9) }
    return ParsePosition(position)
}

fn parse_digits(
    text: Text,
    position: Int,
    end: Int,
    length: Int,
    value: Int
) -> DateTimeOutcome {
    if position == end {
        return DateTimeOk(value)
    }
    let digit: DateTimeOutcome = digit_at(text, position, length)
    match digit {
        DateTimeOk(number) => {
            return parse_digits(
                text,
                position + 1,
                end,
                length,
                value * 10 + number
            )
        },
        other => { return other },
    }
    return ParsePosition(position)
}

# A mismatch is reported at `position` rather than at the start of the field, so
# the caller can hand the same byte to another rule.  `parse_second` relies on
# that: a failed `.` probe is not an error, it just means byte 19 is the offset.
fn require_character(
    text: Text,
    position: Int,
    length: Int,
    expected: Text
) -> DateTimeOutcome {
    if position >= length { return ParsePosition(position) }
    if text_slice(text, position, position + 1) == expected {
        return DateTimeOk(0)
    }
    return ParsePosition(position)
}

fn leap_year(year: Int) -> Int {
    if year % 400 == 0 { return 1 }
    if year % 100 == 0 { return 0 }
    if year % 4 == 0 { return 1 }
    return 0
}

fn days_in_month(year: Int, month: Int) -> Int {
    if month == 2 {
        if leap_year(year) == 1 { return 29 }
        return 28
    }
    if month == 4 { return 30 }
    if month == 6 { return 30 }
    if month == 9 { return 30 }
    if month == 11 { return 30 }
    return 31
}

# The calendar rule is the only one that needs more than one field at once, so
# it is factored out and shared by both failure vocabularies below.
fn validate_date(year: Int, month: Int, day: Int) -> DateTimeOutcome {
    if month < 1 { return InvalidField(2) }
    if month > 12 { return InvalidField(2) }
    if day < 1 { return InvalidField(3) }
    if day > days_in_month(year, month) { return InvalidField(3) }
    return DateTimeOk(day)
}

# Two deliberately different vocabularies.  A value built from Ints has no bytes
# to point at, so `validate_parts` reports a field ordinal; text parsed from
# RFC 3339 does have bytes, so the parser reports the exact byte instead.  The
# parser therefore range-checks `time-hour`, `time-minute`, and `time-second`
# itself and never reaches the ordinals 4..7 here; those remain the contract for
# the constructed-value path and are exercised directly from `main`.
fn validate_parts(
    year: Int,
    month: Int,
    day: Int,
    hour: Int,
    minute: Int,
    second: Int,
    nanosecond: Int
) -> DateTimeOutcome {
    let date: DateTimeOutcome = validate_date(year, month, day)
    match date {
        DateTimeOk(_) => {},
        other => { return other },
    }
    if hour < 0 { return InvalidField(4) }
    if hour > 23 { return InvalidField(4) }
    if minute < 0 { return InvalidField(5) }
    if minute > 59 { return InvalidField(5) }
    if second < 0 { return InvalidField(6) }
    if second > 59 { return InvalidField(6) }
    if nanosecond < 0 { return InvalidField(7) }
    if nanosecond > 999999999 { return InvalidField(7) }
    return DateTimeOk(nanosecond)
}

fn scale_fraction(value: Int, digits: Int) -> Int {
    if digits == 9 { return value }
    return scale_fraction(value * 10, digits + 1)
}

# `DateTimeOutcome` carries exactly one Int, and a successful parse produces two
# numbers worth observing: the nanosecond of the second and the UTC offset in
# seconds.  Packing both into one Int would make both unreadable in the golden
# (a signed offset scaled by 1e9 plus a nanosecond), so the walk instead carries
# a `projection` selector: `0` yields the nanosecond, `1` yields offset seconds.
# The selector never influences parsing, only which number the success carries.
fn project_parse(
    nanosecond: Int,
    offset_seconds: Int,
    projection: Int
) -> DateTimeOutcome {
    if projection == 1 { return DateTimeOk(offset_seconds) }
    return DateTimeOk(nanosecond)
}

# `position` is the first digit of the offset minute, so the sign byte sits four
# bytes earlier in `sHH:MM`.
fn parse_offset_minute(
    text: Text,
    length: Int,
    position: Int,
    sign: Int,
    hour: Int,
    nanosecond: Int,
    projection: Int
) -> DateTimeOutcome {
    let result: DateTimeOutcome = parse_digits(
        text,
        position,
        position + 2,
        length,
        0
    )
    match result {
        DateTimeOk(minute) => {
            if minute > 59 { return ParsePosition(position) }
            if length != position + 2 { return ParsePosition(position + 2) }
            # RFC 3339 section 4.3 gives `-00:00` the distinct meaning "the
            # offset to local time is unknown".  This profile has no value for
            # that, so it is refused at the sign byte instead of being silently
            # read as UTC.  `+00:00` stays accepted; it does mean UTC.
            if sign < 0 {
                if hour == 0 {
                    if minute == 0 { return ParsePosition(position - 4) }
                }
            }
            return project_parse(
                nanosecond,
                sign * (hour * 3600 + minute * 60),
                projection
            )
        },
        other => { return other },
    }
    return ParsePosition(position)
}

# `position` is the first digit of the offset hour.  RFC 3339 spells the
# separator as a literal `:`, so `+0100` is refused at the byte where the colon
# was required rather than accepted as the ISO 8601 basic format.
fn parse_offset_hour(
    text: Text,
    length: Int,
    position: Int,
    sign: Int,
    nanosecond: Int,
    projection: Int
) -> DateTimeOutcome {
    let result: DateTimeOutcome = parse_digits(
        text,
        position,
        position + 2,
        length,
        0
    )
    match result {
        DateTimeOk(hour) => {
            if hour > 23 { return ParsePosition(position) }
            let separator: DateTimeOutcome = require_character(
                text,
                position + 2,
                length,
                ":"
            )
            match separator {
                DateTimeOk(_) => {
                    return parse_offset_minute(
                        text,
                        length,
                        position + 3,
                        sign,
                        hour,
                        nanosecond,
                        projection
                    )
                },
                other => { return other },
            }
        },
        other => { return other },
    }
    return ParsePosition(position)
}

# `position` is the first byte of RFC 3339 `time-offset`.  The grammar admits
# only `Z`, `+HH:MM`, and `-HH:MM`; a lowercase `z`, a comma left over from an
# ISO 8601 decimal separator, and a missing terminator all land here and are all
# refused at this byte.
fn parse_offset(
    text: Text,
    length: Int,
    position: Int,
    nanosecond: Int,
    projection: Int
) -> DateTimeOutcome {
    if position >= length { return ParsePosition(position) }
    let symbol = text_slice(text, position, position + 1)
    if symbol == "Z" {
        # Nothing may follow the terminator, so trailing whitespace is refused
        # at the first extra byte rather than ignored.
        if length != position + 1 { return ParsePosition(position + 1) }
        return project_parse(nanosecond, 0, projection)
    }
    if symbol == "+" {
        return parse_offset_hour(
            text,
            length,
            position + 1,
            1,
            nanosecond,
            projection
        )
    }
    if symbol == "-" {
        return parse_offset_hour(
            text,
            length,
            position + 1,
            0 - 1,
            nanosecond,
            projection
        )
    }
    return ParsePosition(position)
}

# RFC 3339 `time-secfrac` is `"." 1*DIGIT`.  Precision stops at the nanosecond
# the `Instant` representation actually carries, so a tenth digit is refused at
# that exact byte instead of being truncated silently; and a point with no digit
# after it is refused at the byte where the first digit was required.
fn parse_fraction(
    text: Text,
    length: Int,
    position: Int,
    digits: Int,
    value: Int,
    projection: Int
) -> DateTimeOutcome {
    if digits == 9 {
        let extra: DateTimeOutcome = digit_at(text, position, length)
        match extra {
            DateTimeOk(_) => { return ParsePosition(position) },
            other => {
                return parse_offset(
                    text,
                    length,
                    position,
                    value,
                    projection
                )
            },
        }
    }
    let digit: DateTimeOutcome = digit_at(text, position, length)
    match digit {
        DateTimeOk(number) => {
            return parse_fraction(
                text,
                length,
                position + 1,
                digits + 1,
                value * 10 + number,
                projection
            )
        },
        other => {
            if digits == 0 { return ParsePosition(position) }
            return parse_offset(
                text,
                length,
                position,
                scale_fraction(value, digits),
                projection
            )
        },
    }
    return ParsePosition(position)
}

fn parse_second(
    text: Text,
    length: Int,
    projection: Int
) -> DateTimeOutcome {
    let result: DateTimeOutcome = parse_digits(text, 17, 19, length, 0)
    match result {
        DateTimeOk(second) => {
            # RFC 3339 admits `60` only for a leap second, and the contract
            # states leap seconds are not representable, so `:60` is refused at
            # byte 17 where `time-second` begins.
            if second > 59 { return ParsePosition(17) }
            let point: DateTimeOutcome = require_character(text, 19, length, ".")
            match point {
                DateTimeOk(_) => {
                    return parse_fraction(text, length, 20, 0, 0, projection)
                },
                other => {
                    # A failed probe is not an error: byte 19 is simply not a
                    # fraction, so it must be the offset.
                    return parse_offset(text, length, 19, 0, projection)
                },
            }
        },
        other => { return other },
    }
    return ParsePosition(17)
}

fn parse_minute(
    text: Text,
    length: Int,
    projection: Int
) -> DateTimeOutcome {
    let result: DateTimeOutcome = parse_digits(text, 14, 16, length, 0)
    match result {
        DateTimeOk(minute) => {
            if minute > 59 { return ParsePosition(14) }
            let separator: DateTimeOutcome = require_character(
                text,
                16,
                length,
                ":"
            )
            match separator {
                DateTimeOk(_) => {
                    return parse_second(text, length, projection)
                },
                other => { return other },
            }
        },
        other => { return other },
    }
    return ParsePosition(14)
}

fn parse_hour(
    text: Text,
    length: Int,
    projection: Int
) -> DateTimeOutcome {
    let result: DateTimeOutcome = parse_digits(text, 11, 13, length, 0)
    match result {
        DateTimeOk(hour) => {
            # `24:00` is a legal ISO 8601 end-of-day spelling and an illegal
            # RFC 3339 `time-hour`; it is refused at byte 11, where the field
            # begins, not at the input's end.
            if hour > 23 { return ParsePosition(11) }
            let separator: DateTimeOutcome = require_character(
                text,
                13,
                length,
                ":"
            )
            match separator {
                DateTimeOk(_) => {
                    return parse_minute(text, length, projection)
                },
                other => { return other },
            }
        },
        other => { return other },
    }
    return ParsePosition(11)
}

fn parse_day(
    text: Text,
    length: Int,
    year: Int,
    month: Int,
    projection: Int
) -> DateTimeOutcome {
    let result: DateTimeOutcome = parse_digits(text, 8, 10, length, 0)
    match result {
        DateTimeOk(day) => {
            let date: DateTimeOutcome = validate_date(year, month, day)
            match date {
                DateTimeOk(_) => {},
                other => { return other },
            }
            # Only an uppercase `T` separates date from time; a space and a
            # lowercase `t` are both refused at byte 10.
            let separator: DateTimeOutcome = require_character(
                text,
                10,
                length,
                "T"
            )
            match separator {
                DateTimeOk(_) => {
                    return parse_hour(text, length, projection)
                },
                other => { return other },
            }
        },
        other => { return other },
    }
    return ParsePosition(8)
}

fn parse_month(
    text: Text,
    length: Int,
    year: Int,
    projection: Int
) -> DateTimeOutcome {
    let result: DateTimeOutcome = parse_digits(text, 5, 7, length, 0)
    match result {
        DateTimeOk(month) => {
            let separator: DateTimeOutcome = require_character(
                text,
                7,
                length,
                "-"
            )
            match separator {
                DateTimeOk(_) => {
                    return parse_day(text, length, year, month, projection)
                },
                other => { return other },
            }
        },
        other => { return other },
    }
    return ParsePosition(5)
}

fn parse_year(text: Text, length: Int, projection: Int) -> DateTimeOutcome {
    let result: DateTimeOutcome = parse_digits(text, 0, 4, length, 0)
    match result {
        DateTimeOk(year) => {
            let separator: DateTimeOutcome = require_character(
                text,
                4,
                length,
                "-"
            )
            match separator {
                DateTimeOk(_) => {
                    return parse_month(text, length, year, projection)
                },
                other => { return other },
            }
        },
        other => { return other },
    }
    return ParsePosition(0)
}

# The accepted grammar is exactly
# `YYYY-MM-DDTHH:MM:SS[.1..9 digits](Z | (+|-)HH:MM)`.
#
# There is deliberately no length precheck any more.  The previous version
# refused anything under 20 bytes with `ParsePosition(length)`, which reported
# the input's end rather than the defect: `2024-02-29T12:34Z` blamed byte 17
# when the missing `:` is at byte 16.  Bounds-checking each read instead lets
# the walk fail at the first byte that violates the grammar, whatever the
# length.  On success this carries the nanosecond of the second.
fn parse_rfc3339(text: Text) -> DateTimeOutcome {
    return parse_year(text, len(text), 0)
}

# The same walk over the same grammar, carrying the parsed UTC offset in seconds
# on success.  `Z` and `+00:00` both yield 0; a negative offset yields a negative
# number, which is why it cannot share the payload with the nanosecond.
fn parse_rfc3339_offset(text: Text) -> DateTimeOutcome {
    return parse_year(text, len(text), 1)
}

fn observe(outcome: DateTimeOutcome) -> Int {
    let mut result = 0
    match outcome {
        DateTimeOk(value) => { result = 100 + value },
        InvalidField(field) => { result = 200 + field },
        ParsePosition(position) => { result = 300 + position },
        InexactConversion(remainder) => { result = 400 + remainder },
        ArithmeticOverflow(operation) => { result = 500 + operation },
    }
    return result
}

fn main() -> Int {
    let duration: Duration = make_duration(3, 4)
    print(same_duration(duration, make_duration(3, 4)))

    let instant: Instant = make_instant(5, 6)
    print(same_instant(instant, make_instant(5, 6)))

    let date: Date = make_date(2024, 2, 29)
    print(same_date(date, make_date(2024, 2, 29)))

    let time: TimeOfDay = make_time(12, 34, 56, 789)
    print(same_time(time, make_time(12, 34, 56, 789)))

    let local: LocalDateTime = make_local_date_time(2024, 2, 29, 12, 34, 56, 789)
    print(same_local_date_time(
        local,
        make_local_date_time(2024, 2, 29, 12, 34, 56, 789)    ))

    let offset: UtcOffset = make_utc_offset(0)
    print(same_utc_offset(offset, make_utc_offset(0)))

    let offset_date_time: OffsetDateTime = make_offset_date_time(
        2024,
        2,
        29,
        12,
        34,
        56,
        789,
        0    )
    print(same_offset_date_time(
        offset_date_time,
        make_offset_date_time(2024, 2, 29, 12, 34, 56, 789, 0)    ))

    print(observe(parse_rfc3339("2024-02-29T12:34:56Z")))
    print(observe(parse_rfc3339("2023-02-29T12:34:56Z")))

    let negative: Duration = normalize_duration(0, -1)
    print(negative.seconds)
    print(negative.nanoseconds)

    print(observe(checked_add(9223372036854775807, 1)))
    print(observe(parse_rfc3339("2024-02-29T12:34:X6Z")))
    print(observe(nanos_to_millis(1000001)))
    print(observe(parse_rfc3339("2024-02-29T12:34:56.123456789Z")))

    # Accepted `time-offset` forms.  Each offset string is observed twice: once
    # through the nanosecond projection to show the parse succeeded, and once
    # through the offset projection to show which offset it decoded to.  A
    # "did not fail" observation alone would not distinguish `+09:00` from
    # `-05:30`.
    print(observe(parse_rfc3339("2024-02-29T12:34:56+09:00")))
    print(observe(parse_rfc3339_offset("2024-02-29T12:34:56+09:00")))
    print(observe(parse_rfc3339_offset("2024-02-29T12:34:56-05:30")))
    print(observe(parse_rfc3339_offset("2024-02-29T12:34:56+00:00")))
    print(observe(parse_rfc3339_offset("2024-02-29T12:34:56Z")))
    print(observe(parse_rfc3339_offset("2024-02-29T12:34:56+23:59")))
    print(observe(parse_rfc3339("2024-02-29T12:34:56.5-05:30")))
    print(observe(parse_rfc3339_offset("2024-02-29T12:34:56.5-05:30")))
    print(observe(parse_rfc3339("2024-02-29T12:34:56.123456789+09:00")))
    print(observe(parse_rfc3339_offset("2024-02-29T12:34:56.123456789+09:00")))

    # The rejection matrix.  Every line is a form the strict profile must refuse
    # at one exact byte, and `observe` reports that byte as `300 + position`.
    print(observe(parse_rfc3339(" 2024-02-29T12:34:56Z")))
    print(observe(parse_rfc3339("2024-02-29 12:34:56Z")))
    print(observe(parse_rfc3339("2024-02-29t12:34:56Z")))
    print(observe(parse_rfc3339("2024-02-29T12:34:56z")))
    print(observe(parse_rfc3339("2024-02-29T12:34Z")))
    print(observe(parse_rfc3339("2024-02-29T12:34:56,123Z")))
    print(observe(parse_rfc3339("2024-02-29T12:34:56.1234567890Z")))
    print(observe(parse_rfc3339("2024-02-29T24:00:00Z")))
    print(observe(parse_rfc3339("2024-02-29T12:34:60Z")))
    print(observe(parse_rfc3339("2024-02-29T12:34:56+0100")))
    print(observe(parse_rfc3339("2024-02-29T12:34:56-00:00")))
    print(observe(parse_rfc3339("2024-02-29T12:34:56Z ")))

    # Neighbouring defects that share the same code paths, kept so a fix to one
    # matrix row cannot quietly move another row's byte.
    print(observe(parse_rfc3339("2024-02-29T12:34:56.Z")))
    print(observe(parse_rfc3339("2024-02-29T12:34:56+24:00")))
    print(observe(parse_rfc3339("2024-02-29T12:34:56+00:60")))
    print(observe(parse_rfc3339("2024-02-29T12:34:56+09:0")))
    print(observe(parse_rfc3339("2024-02-29T12:34:56+09:00Z")))
    print(observe(parse_rfc3339("2024-02-29T12:34:56")))
    print(observe(parse_rfc3339("2024")))

    # The constructed-value path keeps the field-ordinal vocabulary: a tuple of
    # Ints has no byte to point at, so hour 24 is `InvalidField(4)` here while
    # the same value in text is a byte position.
    print(observe(validate_parts(2024, 2, 29, 12, 34, 56, 789)))
    print(observe(validate_parts(2024, 2, 29, 24, 0, 0, 0)))
    return 0
}
